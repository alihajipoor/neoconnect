# Production secrets for infra/docker-compose.prod.yml.
# The panel installer (installer/lib/panel.sh) generates infra/.env with
# real random values automatically — this file just documents the shape.

POSTGRES_PASSWORD=change-me
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CUSTOMER_JWT_ACCESS_SECRET=change-me-customer-access
CUSTOMER_JWT_REFRESH_SECRET=change-me-customer-refresh
CUSTOMER_JWT_ACCESS_TTL=15m
CUSTOMER_JWT_REFRESH_TTL=7d
CREDENTIALS_ENCRYPTION_KEY=change-me-32-raw-bytes-hex-encoded

# Fill these in yourself -- not auto-generated since they're credentials
# from an external service, not secrets the installer can invent:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
ALERT_WEBHOOK_URL=
# Public https address of the API, including the /api prefix nginx proxies
# under -- e.g. https://panel.example.com/api. Verification emails link
# here, so a wrong value produces buttons that go nowhere. Set
# automatically by the installer from the panel's own domain.
PUBLIC_API_URL=
