# Production secrets for infra/docker-compose.prod.yml.
# The panel installer (installer/lib/panel.sh) generates infra/.env with
# real random values automatically — this file just documents the shape.

POSTGRES_PASSWORD=change-me
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
# Admin panel sessions, sliding: the idle limit, and the cap counted from
# the sign-in. Blank = 1h and 12h. (JWT_REFRESH_TTL is no longer read.)
ADMIN_SESSION_IDLE=
ADMIN_SESSION_MAX=
CUSTOMER_JWT_ACCESS_SECRET=change-me-customer-access
CUSTOMER_JWT_REFRESH_SECRET=change-me-customer-refresh
CUSTOMER_JWT_ACCESS_TTL=15m
CUSTOMER_JWT_REFRESH_TTL=7d
CREDENTIALS_ENCRYPTION_KEY=change-me-32-raw-bytes-hex-encoded
# Names the exits a customer can send a game to, opaquely and per
# customer. Optional; falls back to CREDENTIALS_ENCRYPTION_KEY. Keep it
# stable once set -- changing it renames every exit and costs customers
# their saved per-game choices.
EXIT_HANDLE_SECRET=change-me-32-raw-bytes-hex-encoded

# Fill these in yourself -- not auto-generated since they're credentials
# from an external service, not secrets the installer can invent:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

PLISIO_API_KEY=
ALERT_WEBHOOK_URL=

# App Store in-app purchases. The bundle id the signed transactions must
# carry -- com.neoxify.mobile -- set when App Store purchases go live;
# unset refuses every purchase and restore. APPLE_ALLOW_SANDBOX=true
# accepts sandbox/TestFlight transactions too, free for anyone with a
# beta build, so leave it unset in production.
APPLE_BUNDLE_ID=
APPLE_ALLOW_SANDBOX=

# Optional GitHub token for the release-feed lookups behind /api/updates.
# Raises GitHub's API limit from 60 requests an hour per IP to 5,000. A
# fine-grained token with NO scopes and no repository access is enough --
# the repo is public and only public release metadata is read. Unset is
# supported; the calls are made anonymously against the 60/hour budget.
GITHUB_API_TOKEN=
# Public https address of the API, including the /api prefix nginx proxies
# under -- e.g. https://panel.example.com/api. Verification emails link
# here, so a wrong value produces buttons that go nowhere. Set
# automatically by the installer from the panel's own domain.
PUBLIC_API_URL=

# Recent sign-in failures tolerated before a solved proof-of-work
# challenge becomes mandatory. Blank = 5.
#
# 0 requires one on EVERY attempt, which is where this should end up --
# it is the difference between an attacker getting five free password
# guesses per account per half hour and none. Do not set it until every
# customer is on a client that solves challenges: no desktop or Android
# build released so far contains the solver, so 0 today refuses their
# first sign-in, not their sixth.
LOGIN_CHALLENGE_GRACE_FAILURES=

# How many of one customer's signed-in devices may hold VPN credentials
# of their own. Blank = 10, at most 50. A hidden safety cap for the
# nodes (every device credential is a WireGuard peer out of a /24), not
# the plan's device limit. See docs/per-device-credentials.md.
CUSTOMER_DEVICE_CREDENTIAL_LIMIT=

# The node-side backstop for the plan's device limit. Blank = shadow:
# it logs "would hold device X" and sends nothing. "enforce" holds that
# device's credentials until the other device goes quiet. See
# docs/device-slots.md before changing it.
CONCURRENCY_CUT=

# Device slots: the plan's device limit as the apps ask for it before
# connecting. Blank = enforce (a device past the limit is refused with
# 409 DEVICE_LIMIT and offered "Use on this device instead"). "off"
# grants every claim. Only app releases that claim are affected.
DEVICE_SLOTS=

# "Sign out of another device" in the apps' Activity page
# (DELETE /customer/devices/:id). Blank = off: the route answers 404.
# "on" only together with the app release that offers it, once the owner
# has decided it. See docs/account-activity.md.
ACCOUNT_DEVICE_SIGNOUT=

# Block watch: notices servers that look blocked from the probe country
# and tells the owner. It never changes, buys or replaces anything.
# Blank/off = nothing runs. record = verdicts in the panel (Block watch)
# only. digest = also a daily digest by webhook and email, no pages (run
# this a fortnight first). notify = pages for likely blocks too.
BLOCK_WATCH=

# The block watch's thresholds, as name=value pairs separated by commas
# (the names are in parseTuning, apps/backend/src/modules/block-watch/
# block-signals.ts). Keep the values in use here and in the owner's
# private notes only, never in the repository: published, they say how
# to shape a block that is not noticed. Blank = the fallbacks in the code.
BLOCK_WATCH_TUNING=

# Minutes without a heartbeat before the owner is paged that a node has
# gone quiet (webhook + every SUPERADMIN's email), once per gap and once
# when it is back; gaps found in one sweep are one message. Blank or 0 =
# off (the default). 10 is a sensible value to turn it on with.
HEARTBEAT_GAP_PAGE_MINUTES=

# Publishes Swagger UI at /api/docs, unauthenticated. Blank = off in
# production, which is the right answer: it is a complete index of every
# admin route and payload shape, and it was live until 2026-08-14.
ENABLE_API_DOCS=
