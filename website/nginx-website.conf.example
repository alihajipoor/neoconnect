# Neoxify website -- nginx server block.
#
# ============================================================================
# READ THIS FIRST. THIS FILE IS NOT DEPLOYED BY ANYTHING IN THE REPO.
# ============================================================================
#
# neoxify.net is served by nginx, which never reads .htaccess. Measured
# 2026-08-14 and again 2026-08-24 against the live host, with this file not
# installed: every unknown URL returned the home page with a 200 (unlimited
# soft-404 duplicates), /sitemap.xml returned the home page, there were no
# security headers, no compression and no caching headers, voucher short
# links did nothing, and www. served a full duplicate site.
#
# Since the 2026-10 redesign PHP sends the security headers itself on every
# page (inc/headers.php), so a missed install no longer leaves the HTML
# naked. This file is still what gives the STATIC files their headers,
# compression and caching, the real 404s, the sitemap and the short links.
#
# HOW THE HEADERS ARE SPLIT, so none is ever sent twice:
#   - nginx sends the fixed set (HSTS, nosniff, Referrer-Policy, XFO,
#     Permissions-Policy, COOP, CORP) on EVERY response, and hides PHP's
#     copies of exactly those with fastcgi_hide_header.
#   - The Content-Security-Policy on a page is PHP's alone. It pins the
#     page's inline stylesheet and its one inline script by SHA-256, so it
#     differs per page and cannot be written down here. nginx adds its own
#     static policy only when the upstream sent none (the `map` below):
#     static files, and the /account/ portal, which is a static build.
#   Two CSP headers on one response would BOTH be enforced -- a static one
#   here would block the page's own inline CSS. That is why the map exists.
#
# TO DEPLOY: copy onto the web host, fix the paths marked CHECK, `nginx -t`,
# then `systemctl reload nginx`. Set expose_php = Off in php.ini as well.

# ---------------------------------------------------------------------
# 0. Static CSP, only where PHP did not send one (http context)
# ---------------------------------------------------------------------
# connect-src is wider than 'self' on purpose: /account/ is the customer
# portal and every call it makes goes to another origin -- connect.neoxify.site
# first, then mirrors on neoxify.site names on nonstandard ports, derived at
# runtime from the customer's own credentials. See .htaccess for the long
# version. Nothing else on the site makes a request at all.
map $upstream_http_content_security_policy $nx_static_csp {
    ""      "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.neoxify.site:*; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";
    default "";
}

# ---------------------------------------------------------------------
# 1. Canonical host: everything 301s to https://neoxify.net
# ---------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name neoxify.net www.neoxify.net;
    server_tokens off;

    # ACME renewals must not be redirected or certbot's HTTP-01 challenge
    # fails and the certificate quietly stops renewing.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://neoxify.net$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
                                   # This host runs nginx 1.24.0, where
                                   # `http2 on;` does not exist and would
                                   # fail `nginx -t`. The form above is
                                   # accepted by 1.24 and (deprecated) by
                                   # 1.25+. On 1.25.1+ you may drop http2
                                   # from these lines and add `http2 on;`.
    server_name www.neoxify.net;
    server_tokens off;

    # CHECK: leave whatever certbot already wrote for this host. The cert
    # must cover www as well as the apex, or this block cannot answer.
    # ssl_certificate     /etc/letsencrypt/live/neoxify.net/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/neoxify.net/privkey.pem;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    return 301 https://neoxify.net$request_uri;
}

# ---------------------------------------------------------------------
# 2. The site
# ---------------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name neoxify.net;

    # CHECK: document root of the unzipped site.
    root /var/www/neoxify.net;
    # index.html for ONE directory: /account/, the compiled customer
    # portal, which has no index.php. index.php stays first so no stray
    # index.html can shadow a PHP page.
    index index.php index.html;

    # CHECK: ssl_certificate / ssl_certificate_key -- leave certbot's.

    charset utf-8;
    # No version in the Server header or on error pages.
    server_tokens off;

    # ------------------------------------------------------------------
    # Security headers
    # ------------------------------------------------------------------
    # nginx REPLACES inherited add_header directives in any block that adds
    # one of its own, so every location below that sets a header repeats
    # the whole set (`include`-ing a snippet is the tidier way on a host
    # where you can add files to /etc/nginx/snippets/).
    #
    # HSTS: two years, every subdomain, and preload-READY. The header alone
    # does nothing irreversible; submitting the domain at hstspreload.org
    # is a separate step, close to irreversible (removal takes months to
    # reach shipped browsers), and the owner's decision. Confirm every
    # neoxify.net name serves HTTPS before reloading with includeSubDomains.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    # Only feature names current browsers recognise: an unknown one (the
    # old interest-cohort) is logged as a console error on every page.
    add_header Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=(), browsing-topics=()" always;
    add_header Content-Security-Policy $nx_static_csp always;

    # ------------------------------------------------------------------
    # Compression
    # ------------------------------------------------------------------
    # Every page inlines its own CSS (no render-blocking request), so the
    # HTML is the biggest text on the wire -- compress it. nginx always
    # compresses text/html once gzip is on; listing it warns.
    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml application/xml application/javascript application/json application/ld+json application/manifest+json image/svg+xml;

    # Better again if ngx_brotli is available. Safe to leave commented out.
    # brotli on;
    # brotli_comp_level 5;
    # brotli_types text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml;

    # ------------------------------------------------------------------
    # Not pages
    # ------------------------------------------------------------------
    # Second layer only: every file in data/ begins with `<?php exit; ?>`
    # and every file under inc/ with `defined('NX') || exit;`.
    location ^~ /data/    { deny all; return 404; }
    location ^~ /inc/     { deny all; return 404; }
    location ^~ /scripts/ { deny all; return 404; }
    location ~ /\.        { deny all; return 404; }

    # ------------------------------------------------------------------
    # Static assets: cached for a year
    # ------------------------------------------------------------------
    # Safe because nothing here changes in place: CSS is inlined into the
    # pages, the script, favicon and touch icon carry a ?v= stamp from the
    # file's mtime (nx_asset()), and the fonts, the map and the social
    # cards carry a version IN THE FILE NAME (-v1, -v2) -- change the file,
    # change the name. The fonts deliberately have no ?v=, so the preload
    # in the page and the @font-face request the same URL.
    location ~* \.(css|js|woff2|svg|png|jpg|jpeg|webp|avif|ico)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header Content-Security-Policy $nx_static_csp always;
        access_log off;
        try_files $uri =404;
    }

    # The social cards and the logo are meant to be shown by other sites
    # and apps, so they may be embedded cross-origin.
    location ^~ /assets/img/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        access_log off;
        try_files $uri =404;
    }

    # ------------------------------------------------------------------
    # Rewrites
    # ------------------------------------------------------------------
    location = /sitemap.xml {
        rewrite ^ /sitemap.php last;
    }

    # Voucher short links: /r/ABCD2345 -> r/index.php?c=ABCD2345
    location ~ "^/r/([A-Za-z0-9-]{1,32})/?$" {
        rewrite ^ /r/index.php?c=$1 last;
    }

    # ------------------------------------------------------------------
    # Pages
    # ------------------------------------------------------------------
    # A missing page must be a real 404 rendered by 404.php, not a 200
    # showing the home page.
    error_page 404 /404.php;

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ \.php$ {
        try_files $uri =404;

        # PHP sends these too (inc/headers.php), so a host without this file
        # is still covered; hide PHP's copies so each goes out exactly once.
        # NOT the CSP: that is PHP's alone (see the top of this file).
        fastcgi_hide_header Strict-Transport-Security;
        fastcgi_hide_header X-Content-Type-Options;
        fastcgi_hide_header Referrer-Policy;
        fastcgi_hide_header X-Frame-Options;
        fastcgi_hide_header Cross-Origin-Opener-Policy;
        fastcgi_hide_header Cross-Origin-Resource-Policy;
        fastcgi_hide_header Permissions-Policy;
        fastcgi_hide_header X-Powered-By;

        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=(), browsing-topics=()" always;
        # Empty whenever PHP sent its own policy, which every page does.
        add_header Content-Security-Policy $nx_static_csp always;
        # Cache-Control comes from PHP: pages are per request and vary on the
        # language cookie, so they are revalidated every time.

        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        # PATH_INFO lets /r/index.php/CODE work on a host with no rewrite.
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        # CHECK: the php-fpm socket path for the installed PHP version.
        fastcgi_pass unix:/run/php/php-fpm.sock;
    }
}
