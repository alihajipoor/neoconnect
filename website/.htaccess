# Neoxify website -- Apache / LiteSpeed configuration.
#
# Every directive is wrapped in <IfModule> so that a host missing any given
# module serves the site normally instead of returning a 500. Nothing here is
# required for the site to function: the security headers and caching are
# improvements, and the deny rules are a second layer over protections that
# already exist in PHP (see inc/security.php's file guard).

Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

ErrorDocument 404 /404.php

# ---------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

    # No 'unsafe-inline' anywhere: the site has no inline <script> and no
    # style="..." attributes -- templates use the utility classes at the
    # bottom of assets/css/site.css instead. If you ever add an inline style
    # or script, fix the template rather than weakening this header.
    #
    # 'self' only, with data: for images because the favicon and any inline
    # SVG data URIs need it. No third-party origins load anything here.
    #
    # connect-src is the one exception, and it is not optional: /account/
    # is the customer portal, and every call it makes -- sign in, plans,
    # purchase, vouchers -- goes to a DIFFERENT origin. 'self' alone
    # blocks all of them, and the portal then renders perfectly and fails
    # at the first request with nothing on screen to explain it.
    #
    # It is a wildcard over neoxify.site rather than one hostname because
    # the portal reuses the apps' endpoint ladder (apps/desktop-windows/
    # src/lib/api-endpoints.ts): connect.neoxify.site first, then the node
    # mirrors on their VPN ports, then further mirrors derived at runtime
    # from whatever credentials the customer holds. Those last ones cannot
    # be enumerated here -- any node may become one -- and every one of
    # them is a neoxify.site name on a nonstandard port by design. Naming
    # only the panel would leave the portal with no failover on exactly
    # the filtered networks the ladder exists for.
    #
    # Nothing else on the site makes an XHR at all.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.neoxify.site:*; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>

# ---------------------------------------------------------------------
# Clean sitemap URL
# ---------------------------------------------------------------------

# Search engines look for /sitemap.xml by convention. Where mod_rewrite is
# available this serves the generated one; where it is not, robots.txt still
# points directly at /sitemap.php, so nothing breaks.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Voucher short links: /r/ABCD1234EFGH -> r/index.php?c=ABCD1234EFGH
    #
    # The code is passed as a query parameter rather than left in the
    # path, because PATH_INFO is not enabled on every shared host. r/
    # index.php reads PATH_INFO as a fallback, so the link still works
    # where mod_rewrite is missing entirely -- it just needs the uglier
    # /r/index.php/CODE form. QSA is deliberately absent: nothing else
    # belongs on this URL.
    RewriteRule ^r/([A-Za-z0-9-]{1,32})/?$ r/index.php?c=$1 [L]
</IfModule>

# ---------------------------------------------------------------------
# Compression and caching
# ---------------------------------------------------------------------

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    # Safe to cache hard: asset URLs carry a ?v= stamp from the file's own
    # mtime (see nx_asset() in inc/bootstrap.php), so a redeploy changes the
    # URL and no visitor can be stuck on a stale stylesheet.
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    # HTML is generated per request and must never be cached by a proxy.
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
