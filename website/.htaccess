# Neoxify website -- Apache / LiteSpeed configuration.
#
# Every directive is wrapped in <IfModule> so that a host missing any given
# module serves the site normally instead of returning a 500. Nothing here is
# required for the site to function: the security headers and caching are
# improvements, and the deny rules are a second layer over protections that
# already exist in PHP (see inc/security.php's file guard).

Options -Indexes

# index.html is in this list because of ONE directory: /account/.
#
# The customer portal is a compiled React SPA whose entry point is
# account/index.html -- there is no index.php anywhere under it. With the
# bare `DirectoryIndex index.php` that used to be here, a request for
# /account/ found no index file and Apache returned 403 (or a directory
# listing, if Options -Indexes were ever removed). The hashed JS and CSS
# under /account/assets/ resolved perfectly the whole time, which is what
# made it look fine: the bundle was reachable, the page that loads it was
# not.
#
# Order matters. index.php stays first, so every marketing page is still
# served by PHP and a stray index.html could never shadow one.
DirectoryIndex index.php index.html
AddDefaultCharset UTF-8

ErrorDocument 404 /404.php

# ---------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------

<IfModule mod_headers.c>
    # PHP sends these on every page itself (inc/headers.php), minus any
    # listed in config.php's headers_sent_by_server. Each fixed header is
    # unset from PHP's set first and then added once here, so it covers
    # static files too and is never sent twice. HSTS without 'preload' on
    # purpose: see inc/headers.php.
    Header unset Strict-Transport-Security
    Header unset X-Content-Type-Options
    Header unset Referrer-Policy
    Header unset X-Frame-Options
    Header unset Cross-Origin-Opener-Policy
    Header unset Cross-Origin-Resource-Policy
    Header unset Permissions-Policy
    Header unset X-Powered-By
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=(), browsing-topics=()"

    # THE CSP ON A PAGE IS PHP'S ALONE: it pins the page's inline
    # stylesheet and its one inline script by SHA-256, so it differs per
    # page. setifempty (not 'always') only adds this static policy where
    # PHP sent none -- static files and the /account/ portal. Two CSP
    # headers would both be enforced, and this one would block the page's
    # own CSS.
    #
    # connect-src is wider than 'self' on purpose: /account/ is the
    # customer portal, and every call it makes goes to a DIFFERENT origin:
    # connect.neoxify.site first, then mirrors on neoxify.site names on
    # nonstandard ports derived at runtime from the customer's credentials
    # (apps/desktop-windows/src/lib/api-endpoints.ts). 'self' alone would
    # leave the portal rendering perfectly and failing at its first
    # request. Nothing else on the site makes a request at all.
    Header setifempty Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.neoxify.site:*; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

# ---------------------------------------------------------------------
# Clean sitemap URL
# ---------------------------------------------------------------------

# Search engines look for /sitemap.xml by convention. Where mod_rewrite is
# available this serves the generated one; where it is not, robots.txt still
# points directly at /sitemap.php, so nothing breaks.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Voucher short links: /r/ABCD1234EFGH -> r/index.php?c=ABCD1234EFGH
    #
    # The code is passed as a query parameter rather than left in the
    # path, because PATH_INFO is not enabled on every shared host. r/
    # index.php reads PATH_INFO as a fallback, so the link still works
    # where mod_rewrite is missing entirely -- it just needs the uglier
    # /r/index.php/CODE form. QSA is deliberately absent: nothing else
    # belongs on this URL.
    RewriteRule ^r/([A-Za-z0-9-]{1,32})/?$ r/index.php?c=$1 [L]
</IfModule>

# ---------------------------------------------------------------------
# Compression and caching
# ---------------------------------------------------------------------

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    # Safe to cache hard: the script and icons carry a ?v= stamp from the
    # file's own mtime (nx_asset() in inc/bootstrap.php), and the fonts,
    # the map and the social cards carry a version in the file name. CSS
    # is inlined into each page, so there is no stylesheet to go stale.
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    # HTML is generated per request and must never be cached by a proxy.
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
