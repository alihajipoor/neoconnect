node_modules/
dist/
# Compiled test output -- the bot's tests run against emitted JS because its
# NodeNext `.js` import specifiers only resolve once emitted.
dist-test/
build/
.next/
.turbo/
*.log
.env
.env.*
!.env.example
.DS_Store
*.tsbuildinfo
coverage/
agent/bin/
agent/*.exe
# Local test agent configs contain a private key -- never meant to be
# committed. The real runtime path is /etc/neoxify/agent.json, outside
# the repo entirely, so any *.json directly under agent/ is a test leftover.
agent/*.json
go.work.sum
.vscode/
.idea/

# Python bytecode from brand/make_store_art.py, imported by
# website/scripts/make-og-image.py. Generated, never useful in a diff.
__pycache__/

# Cached Steam appinfo responses for the game-catalogue generator. Regenerable
# from the network; committing them would add thousands of files that nobody
# reads to make one JSON that everybody does.
apps/backend/prisma/catalogue/tools/.appinfo-cache/
# Reputation-monitor artifacts. They contain live node addresses by
# necessity (that is what is being checked) and this repository is public --
# see docs/node-address-hygiene.md. scripts/check-exit-reputation.py writes
# here and nothing else does.
var/
