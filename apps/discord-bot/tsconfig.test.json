{
  // Tests run against compiled output rather than through a TS loader: the
  // source uses NodeNext, whose `.js` import specifiers only resolve once
  // emitted. Compiling first also means the tests exercise exactly what
  // ships, not a differently-transformed copy of it.
  //
  // The test script cd's into dist-test and runs `node --test` with no
  // path, which behaves the same on every version we care about. The two
  // neater-looking alternatives do not: a glob argument is only expanded
  // from node 22.6 (CI runs 20), and default discovery from the package
  // root also matches the .ts sources on node 22 and tries to run them.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist-test",
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "dist-test"]
}
