{
  "name": "@neoxify/desktop-linux",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "tauri": "tauri",
    "seed": "node ../desktop-windows/scripts/ensure-seed-bundle.mjs && node ../desktop-windows/scripts/apply-capability-scope.mjs src-tauri/capabilities/default.json",
    "prebuild": "node ../desktop-windows/scripts/ensure-seed-bundle.mjs && node ../desktop-windows/scripts/apply-capability-scope.mjs src-tauri/capabilities/default.json",
    "pretypecheck": "NEOXIFY_SKIP_SEED=1 node ../desktop-windows/scripts/ensure-seed-bundle.mjs",
    "fetch-binaries": "bash scripts/fetch-binaries.sh",
    "build:helper": "bash scripts/build-helper.sh",
    "package": "bash scripts/package.sh"
  },
  "dependencies": {
    "@noble/ed25519": "^2",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "2.3.2",
    "@tauri-apps/plugin-deep-link": "2.4.9",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-http": "2.5.9",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-store": "2.4.4",
    "@tauri-apps/plugin-updater": "2.10.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
