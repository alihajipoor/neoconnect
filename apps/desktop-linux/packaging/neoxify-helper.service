# The Neoxify root helper: brings tunnels up and down for the app, which
# talks to it over /run/neoxify/helper.sock.
#
# The hardening below is limited on purpose. The helper has to create tun
# devices, add routes and policy rules, set sysctls such as src_valid_mark
# (as wg-quick does), load an nftables table, and change DNS through
# systemd-resolved or by rewriting /etc/resolv.conf. So /etc, /proc/sys,
# /dev/net/tun and netlink all stay reachable; what it never needs, other
# users' /tmp and realtime scheduling, is closed.
# No ProtectClock or PrivateDevices: both close the device list, and
# /dev/net/tun has to stay open.
#
# Custom mode sorts programs into two control groups of the helper's own
# at the root of the hierarchy (neoxify.split and neoxify.app), so the
# cgroup tree stays writable: no ProtectControlGroups. Home directories are
# read-only rather than hidden, because an update is a package the app
# downloaded into the person's home; the helper copies it into its own
# root-only directory before checking it. It cannot be handed over through
# /tmp or /var/tmp, of which PrivateTmp gives the helper its own copies.
#
# The package manager for an in-app update runs as a transient unit of its
# own, never as a child of this one, because the package's scripts restart
# this unit and a restart kills everything in its control group.
[Unit]
Description=Neoxify VPN helper
Documentation=https://neoxify.net
After=network-pre.target
Wants=network-pre.target

[Service]
Type=simple
ExecStart=/usr/lib/neoxify/neoxify-helper
# Fail open: whatever the helper left (the leak-protection table, routes,
# DNS), a stop or a crash takes it away, so a dead helper never leaves the
# machine without a network.
ExecStopPost=/usr/lib/neoxify/neoxify-helper sweep
Restart=on-failure
RestartSec=2
# Room for every connection the helper serves at once (256) and for the
# nft and ip it must still be able to run to take a tunnel down.
LimitNOFILE=65536

RuntimeDirectory=neoxify
RuntimeDirectoryMode=0755
StateDirectory=neoxify
StateDirectoryMode=0700

NoNewPrivileges=yes
ProtectSystem=true
ProtectHome=read-only
PrivateTmp=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET

[Install]
WantedBy=multi-user.target
