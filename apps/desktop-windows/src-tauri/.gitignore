# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Real, official third-party VPN engine binaries (wireguard.exe, wg.exe,
# and later xray.exe/openvpn.exe) -- fetched by scripts/fetch-binaries.ps1,
# not committed, same "download the real binary at build/install time,
# don't vendor it" pattern the bash installer already uses for the
# server-side agent. See resources/README.md.
/resources/*.exe
