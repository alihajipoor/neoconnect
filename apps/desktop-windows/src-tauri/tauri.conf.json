{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeoConnect",
  "version": "0.1.0",
  "identifier": "com.neoxify.neoconnect",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NeoConnect",
        "width": 400,
        "height": 640,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/wireguard.exe": "resources/wireguard.exe",
      "resources/wg.exe": "resources/wg.exe"
    }
  }
}
