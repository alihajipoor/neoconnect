{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neoxify",
  "version": "0.9.35",
  "identifier": "com.neoxify.neoconnect",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Neoxify",
        "width": 940,
        "height": 700,
        "resizable": true,
        "minWidth": 720,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "neoconnect"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://connect.neoxify.site/api/updates/{{target}}/{{arch}}/{{current_version}}",
        "https://fi1.neoxify.site:2053/api/updates/{{target}}/{{arch}}/{{current_version}}",
        "https://fr1.neoxify.site:2053/api/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwNzM3MzUzMDJGRkU0NkMKUldSczVQOENVM056b0tzN3hFUEJrTWFrejdSelFnNVRaR3JDKzgzY25QUmEyVVhQSnpWUzg2S2MK",
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/wireguard.exe": "resources/wireguard.exe",
      "resources/wg.exe": "resources/wg.exe",
      "resources/xray.exe": "resources/xray.exe",
      "resources/wintun.dll": "resources/wintun.dll",
      "resources/openvpn.exe": "resources/openvpn.exe",
      "resources/libcrypto-3-x64.dll": "resources/libcrypto-3-x64.dll",
      "resources/libssl-3-x64.dll": "resources/libssl-3-x64.dll",
      "resources/libpkcs11-helper-1.dll": "resources/libpkcs11-helper-1.dll",
      "resources/vcruntime140.dll": "resources/vcruntime140.dll",
      "resources/tapctl.exe": "resources/tapctl.exe",
      "resources/neoconnect-service.exe": "resources/neoconnect-service.exe",
      "resources/WinDivert.dll": "resources/WinDivert.dll",
      "resources/WinDivert64.sys": "resources/WinDivert64.sys"
    },
    "windows": {
      "nsis": {
        "template": "installer.nsi",
        "installerHooks": "nsis-hooks.nsh",
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  }
}
