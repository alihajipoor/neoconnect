{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://localhost:4000/*" }, { "url": "https://*.neoxify.com/*" },
        { "url": "https://*.neoxify.com:*/*" }]
    }
  ]
}
