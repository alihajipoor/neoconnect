# Rust build output. `cargo check --target ...` creates this inside the
# plugin because it is its own crate, and `git add -A` then stages tens
# of thousands of files.
/target/
# Tauri writes its Swift API package here for the iOS plugin to depend
# on; it is regenerated by the build and is not ours to carry.
/.tauri/
# Resolved by SwiftPM from the package above, so it pins a path that
# only exists after a build.
/ios/Package.resolved
