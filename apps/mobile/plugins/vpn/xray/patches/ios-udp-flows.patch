-func (u *udpConnectionHandler) connectionFinished(src net.Destination) {
+// sweep ends the flows idle past their limit: their queue is closed, so
+// the outbound reads EOF and lets go of the session. Runs while any flow
+// exists, and not otherwise, so a stopped engine leaves nothing behind.
+func (u *udpConnectionHandler) sweep() {
+	now := time.Now().UnixNano()
 	u.Lock()
-	conn, found := u.udpConns[src]
-	if found {
-		delete(u.udpConns, src)
+	defer u.Unlock()
+	for _, conn := range u.udpConns {
+		if now-conn.last.Load() > int64(conn.idleLimit()) {
+			u.forget(conn)
+		}
+	}
+	if len(u.udpConns) == 0 {
+		u.sweeping = false
+		return
+	}
+	time.AfterFunc(udpFlowSweep, u.sweep)
+}
+
+// forget removes a flow and closes its queue. Called with the lock held.
+func (u *udpConnectionHandler) forget(conn *udpConn) {
+	if found, ok := u.udpConns[conn.src]; ok && found == conn {
+		delete(u.udpConns, conn.src)
+		if conn.lookup {
+			u.lookups--
+		}
 		close(conn.egress)
 	}
+}
+
+func (u *udpConnectionHandler) connectionFinished(conn *udpConn) {
+	u.Lock()
+	u.forget(conn)
 	u.Unlock()
 }
 
