+func (c *udpConn) idleLimit() time.Duration {
+	switch {
+	case c.lookup && c.replied.Load():
+		return udpAnsweredIdle
+	case c.lookup:
+		return udpLookupIdle
+	case c.replied.Load():
+		return udpFlowIdle
+	default:
+		return udpUnrepliedIdle
+	}
