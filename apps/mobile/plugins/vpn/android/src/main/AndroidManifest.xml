<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declared here rather than in the app's manifest so the tunnel and
         the thing that declares it stay together: this service belongs to
         the WireGuard library, and any app merging this plugin in gets it
         whether or not anyone remembered to add it.

         GoBackend starts the service and hands it the TUN descriptor.
         BIND_VPN_SERVICE is what tells Android only the system may bind. -->
    <application>
        <service
            android:name="com.wireguard.android.backend.GoBackend$VpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="systemExempted"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- The Xray protocols' own TUN device. Separate from WireGuard's
             above because that one belongs to the WireGuard library and
             cannot be reused; only one is ever active at a time.

             Runs in its own process, and that is load-bearing rather
             than tidiness. The app links two independent Go runtimes:
             libwg-go.so inside WireGuard's GoBackend, built with go1.20,
             and libgojni.so carrying xray-core, built with go1.26. Both
             install signal handlers. With both live in one process, a
             connect that tried Xray and then fell back to WireGuard
             died on a SIGSEGV inside libwg-go.so - reproduced on an
             emulator, null dereference, one frame, immediately after the
             second tunnel came up.

             A Go runtime cannot be unloaded once dlopen'd, so the only
             way for the two never to coexist is for them never to share
             an address space. The Xray engine loads here; WireGuard's
             stays in the main process, untouched and still the proven
             path. Nothing in the main process may call Neoxifyxray, or
             it pulls the second runtime back in and undoes this. -->
        <service
            android:name="com.neoxify.vpn.NeoxifyTunService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="systemExempted"
            android:process=":xray"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>

    <!-- Android 13+ will not show the tunnel's ongoing notification without
         this, and a VPN running with no visible indication is exactly what
         the platform is trying to prevent. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Required by the `systemExempted` foreground-service type both
         services above declare. Without it Android 14+ refuses the
         startForeground() call with a SecurityException, and because
         that call happens in onStartCommand (on the main thread,
         dispatched by the system, outside every try/catch the plugin
         has) the process is killed outright.

         That is not hypothetical: it is why every Xray protocol crashed
         the app on 0.2.7. WireGuard was unaffected only because the
         GoBackend service predates these rules and never calls
         startForeground itself, which made the fault look like an Xray
         problem when it was a manifest one.

         `systemExempted` is the correct type here rather than a
         workaround. The platform grants it to whichever app the user
         has activated as their VPN (the android:activate_vpn appop,
         one of the alternatives the check accepts). A VPN tunnel is not
         a media, sync or location service, and no closer type exists.

         Note for anyone editing this comment: XML forbids a double
         hyphen inside a comment, so the repo's usual em dash cannot be
         used here. Writing one makes the manifest unparseable and the
         build fails in processReleaseManifest, some way from the cause. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />

    <!-- Android 11+ hides most installed packages from
         getInstalledApplications unless an app declares why it needs them.
         Custom mode is a per-app allow list, so the list of apps IS the
         feature; without this the picker shows a handful of entries and
         looks broken. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

</manifest>
