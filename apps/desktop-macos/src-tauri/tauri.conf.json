{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neoxify",
  "version": "0.1.0",
  "identifier": "com.neoxify.mac",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Neoxify",
        "width": 420,
        "height": 760,
        "resizable": true,
        "minWidth": 380,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://connect.neoxify.site/api/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwNzM3MzUzMDJGRkU0NkMKUldSczVQOENVM056b0tzN3hFUEJrTWFrejdSelFnNVRaR3JDKzgzY25QUmEyVVhQSnpWUzg2S2MK"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist"
    }
  }
}
