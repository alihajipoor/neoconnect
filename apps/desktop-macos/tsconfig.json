{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    // ES2021, matching the Windows and mobile projects. All three
    // compile @shared from the Windows app's src, including the API
    // client that races endpoints with Promise.any, so all three
    // tsconfigs have to agree about what the language provides.
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* The desktop UI lives in the Windows app; see vite.config.ts for
       why it is aliased rather than extracted into a package. Both this
       and the vite alias have to agree -- tsc resolves through here and
       the bundler resolves through there. */
    "baseUrl": ".",
    "paths": { "@shared/*": ["../desktop-windows/src/*"] }
  },
  "include": ["src", "../desktop-windows/src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
