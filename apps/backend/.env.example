PORT=4000
DATABASE_URL="postgresql://neoxify:neoxify@localhost:5432/neoxify?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Separate secrets for customer (not admin) sessions -- see
# modules/customer-auth. Generate with: openssl rand -hex 32
CUSTOMER_JWT_ACCESS_SECRET="change-me-customer-access"
CUSTOMER_JWT_REFRESH_SECRET="change-me-customer-refresh"
CUSTOMER_JWT_ACCESS_TTL="15m"
CUSTOMER_JWT_REFRESH_TTL="7d"

AGENT_GRPC_PORT=50051
# Optional: set both to terminate real TLS (production). Left unset in
# local dev, which falls back to plaintext gRPC.
AGENT_TLS_CERT_PATH=""
AGENT_TLS_KEY_PATH=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""

# AES-256-GCM key for ProtocolUser.credentialsJson envelope encryption --
# 32 raw bytes, hex-encoded. Generate with: openssl rand -hex 32
# Required; the backend throws if a protocol user is created/read
# without it set.
CREDENTIALS_ENCRYPTION_KEY=""

# Optional generic alert webhook (Slack/Discord/Telegram-via-adapter/
# custom endpoint) -- POSTed a plain JSON body when a node goes offline.
# Left unset, alerting is a silent no-op.
ALERT_WEBHOOK_URL=""
# Public https address of this API as a customer's browser reaches it.
# Verification emails link here; left empty they fall back to the 6-digit
# code, which works regardless.
PUBLIC_API_URL="http://localhost:4000"
