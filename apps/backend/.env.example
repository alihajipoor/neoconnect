PORT=4000
DATABASE_URL="postgresql://neoxify:neoxify@localhost:5432/neoxify?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
