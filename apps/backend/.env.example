PORT=4000
DATABASE_URL="postgresql://neoxify:neoxify@localhost:5432/neoxify?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Separate secrets for customer (not admin) sessions -- see
# modules/customer-auth. Generate with: openssl rand -hex 32
CUSTOMER_JWT_ACCESS_SECRET="change-me-customer-access"
CUSTOMER_JWT_REFRESH_SECRET="change-me-customer-refresh"
CUSTOMER_JWT_ACCESS_TTL="15m"
CUSTOMER_JWT_REFRESH_TTL="7d"

AGENT_GRPC_PORT=50051
# Optional: set both to terminate real TLS (production). Left unset in
# local dev, which falls back to plaintext gRPC.
AGENT_TLS_CERT_PATH=""
AGENT_TLS_KEY_PATH=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""

# Plisio. No IPN secret: Plisio signs callbacks with this same key.
PLISIO_API_KEY=

# AES-256-GCM key for ProtocolUser.credentialsJson envelope encryption --
# 32 raw bytes, hex-encoded. Generate with: openssl rand -hex 32
# Required; the backend throws if a protocol user is created/read
# without it set.
CREDENTIALS_ENCRYPTION_KEY=""

# HMAC key behind the opaque per-customer exit handles the customer
# location list carries. Any high-entropy string; generate with:
# openssl rand -hex 32
#
# Optional. Left unset it falls back to CREDENTIALS_ENCRYPTION_KEY under
# its own derivation label, and with neither set every exit handle is
# null -- clients then get no exit vocabulary, offer no per-game exit
# picker, and report every placement as unknown, which is what they did
# before handles existed.
#
# Keep it STABLE. Changing it renames every exit, so a per-game
# preference a customer saved earlier no longer matches the exit their
# session leaves from. That is reported honestly (their game shows as
# being on another exit and keeps working) and costs them a re-pick, but
# it is not free.
EXIT_HANDLE_SECRET=""

# Optional GitHub token for the release-feed lookups behind the download
# and update endpoints. Raises GitHub's API limit from 60 requests an
# hour per IP to 5,000. A fine-grained token with NO scopes is enough --
# the repo is public and only public release metadata is read. Unset is
# fine locally; the calls are just made anonymously.
GITHUB_API_TOKEN=""

# Optional generic alert webhook (Slack/Discord/Telegram-via-adapter/
# custom endpoint) -- POSTed a plain JSON body when a node goes offline.
# Left unset, alerting is a silent no-op.
ALERT_WEBHOOK_URL=""
# Public https address of this API as a customer's browser reaches it.
# Verification emails link here; left empty they fall back to the 6-digit
# code, which works regardless.
PUBLIC_API_URL="http://localhost:4000"

# --- Signing in with Google, Apple and Facebook ---------------------
#
# Each is optional. A provider with no credentials configured refuses
# that one sign-in with "not available right now" and logs which key is
# missing; the others, and password sign-in, are unaffected. That is
# deliberate: a half-configured deployment should lose one button, not
# every way into the app.
#
# PUBLIC_API_URL above must be set for Google and Facebook. The redirect
# registered in both consoles is built from it, and the provider
# compares it byte for byte:
#   <PUBLIC_API_URL>/customer-auth/social/google/callback
#   <PUBLIC_API_URL>/customer-auth/social/facebook/callback

# Google Cloud console > Credentials > OAuth 2.0 Client ID, type "Web
# application". Not an "iOS" or "Android" client: those issue no secret,
# and the exchange happens here rather than on the device precisely so
# the secret never ships in a binary.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Meta for Developers > App settings > Basic. The secret signs app-level
# API calls as well as this exchange, so it is a credential for the
# whole app, not just for login.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Comma-separated list of audiences to accept in an Apple identity
# token. For the native iOS sheet this is the app's bundle identifier,
# not a client id -- that flow has no client secret and issues nothing
# to keep, which is why Apple needed no credential configured here. A
# future macOS or web client adds its own entry rather than editing
# this one.
APPLE_SIGNIN_AUDIENCES="com.neoxify.mobile"
