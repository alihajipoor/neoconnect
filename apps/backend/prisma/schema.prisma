generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AdminRole {
  SUPERADMIN
  SUPPORT
  BILLING

  /// A reseller: someone who buys subscription capacity from the operator
  /// up front, outside every payment system, and hands it on to their own
  /// customers as vouchers.
  ///
  /// A panel role rather than a separate account type because what a
  /// reseller does IS administrative -- minting a voucher against a plan
  /// -- and the panel already has the RBAC, the audit log and the session
  /// handling that would otherwise have to be built again. They see only
  /// their own section; RolesGuard is what keeps them out of everything
  /// else, so every reseller endpoint must be explicitly gated.
  RESELLER
}

enum CustomerStatus {
  ACTIVE
  DISABLED
}

enum SubscriptionStatus {
  /// Created but not paid for yet. A customer who picks a plan and then
  /// abandons the payment sits here -- not ACTIVE, which would show them
  /// to the operator as a paying customer and start their clock running.
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum NodeRole {
  RELAY
  EXIT
  STANDALONE
}

enum NodeStatus {
  PENDING
  ONLINE
  OFFLINE
  DISABLED
}

enum Protocol {
  XRAY_VLESS_REALITY
  /// VLESS presenting a real certificate for a real domain, rather than
  /// borrowing a third party's the way REALITY does. Separate from
  /// XRAY_VLESS_REALITY because a client builds a genuinely different
  /// outbound for it -- there are no borrowed-certificate parameters,
  /// only a name to verify. The `transport` column, not another enum
  /// member, is what distinguishes carrying it over TCP from WebSocket.
  XRAY_VLESS_TLS
  XRAY_VMESS
  XRAY_TROJAN
  /// Shadowsocks 2022 (blake3-aes-256-gcm), served by the same xray-core
  /// process as everything above.
  ///
  /// Its own enum member rather than a transport of an Xray protocol,
  /// because the credential is a different kind of thing: a pre-shared
  /// key pair rather than a UUID, and the client builds a shadowsocks
  /// outbound, not a VLESS one.
  ///
  /// The 2022 edition specifically. Original Shadowsocks and SSR are
  /// fingerprinted by state censors and SSR is abandoned upstream, so
  /// offering either would be selling protection this audience would not
  /// actually get.
  SHADOWSOCKS
  WIREGUARD
  OPENVPN
  /// IKEv2/IPsec, served by strongSwan and dialled by the operating
  /// system's own VPN client on both Windows and Android. The only
  /// protocol here that needs no engine shipped with the app.
  ///
  /// Added against the M22 decision that excluded it, because real
  /// customers turned out to have networks where it is the only thing
  /// that connects. That is worth more than the reasoning it overturns.
  ///
  /// It is also the easiest protocol here to identify: fixed UDP 500 and
  /// 4500, a handshake in the clear, no disguise. TCP encapsulation
  /// (RFC 8229) would help against crude UDP blocking but not against
  /// inspection, and neither platform's built-in client appears to
  /// implement it. So it belongs on its own address, away from the
  /// stealth protocols, or a censor blocking this one takes them with
  /// it -- see the node topology notes in the plan.
  IKEV2
}

/// How a protocol's bytes travel. Only meaningful for the Xray-based
/// protocols; WireGuard and OpenVPN carry themselves.
enum Transport {
  TCP
  /// Inside a WebSocket, which on the wire is an ordinary HTTP upgrade
  /// followed by a long-lived connection -- the shape Windscribe sells as
  /// "WStunnel". Needs a path and a real certificate to be convincing.
  WS
  /// gRPC over HTTP/2. Survives some CDNs and HTTP/2-aware middleboxes
  /// that mangle raw WebSockets.
  GRPC
}

/// What the transport is wrapped in.
enum TransportSecurity {
  /// No TLS of its own. Correct for WireGuard and OpenVPN, whose own
  /// protocols handle this, and for an Xray inbound behind a terminator.
  NONE
  /// A real certificate for a real domain. The basis of anything that
  /// should look like an ordinary HTTPS site -- Windscribe's "Stealth"
  /// shape.
  TLS
  /// Borrows a third-party site's certificate rather than presenting its
  /// own, so there is no certificate of ours to fingerprint. Cannot share
  /// a port with a TLS service: it intercepts the handshake and proxies
  /// non-matching clients to the site it is imitating.
  REALITY
}

enum ProtocolUserStatus {
  ACTIVE
  DISABLED
}

enum EnrollmentTokenStatus {
  PENDING
  CLAIMED
  REVOKED
  EXPIRED
}

enum PaymentProvider {
  STRIPE
  NOWPAYMENTS
  /// Appended, never inserted: Postgres orders enum values by creation
  /// and existing rows sort by that order.
  PLISIO
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum ActorType {
  ADMIN
  SYSTEM
  AGENT
}

enum AgentCommandType {
  CREATE_USER
  UPDATE_USER
  DELETE_USER
  DISABLE_USER
  ENABLE_USER
  SET_QUOTA
  SYNC
  CONFIGURE_ROUTE
  REMOVE_ROUTE
}

enum AgentCommandStatus {
  QUEUED
  SENT
  ACKED
  FAILED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(SUPPORT)
  // Set as soon as /auth/mfa/setup generates a candidate secret, but not
  // enforced at login until mfaEnabled flips true via /auth/mfa/enable --
  // otherwise a QR-scan typo during setup could lock the admin out before
  // they've ever confirmed the app on their phone actually works.
  mfaSecret    String?
  mfaEnabled   Boolean   @default(false)
  tokenVersion Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  enrollmentTokens EnrollmentToken[]

  /// Only ever populated for RESELLER accounts.
  resellerBalances ResellerTokenBalance[]
  issuedVouchers   Voucher[]              @relation("VoucherIssuer")

  @@map("admin_users")
}

/// How many vouchers of one plan a reseller may still mint.
///
/// Per plan rather than a single wallet, because that is how the capacity
/// is actually sold -- "10 Starter, 5 Pro" -- and a shared balance would
/// let someone who paid for ten cheap plans mint ten expensive ones.
///
/// There is deliberately no separate Reseller entity. The AdminUser with
/// role RESELLER *is* the reseller: it already carries the identity, the
/// login, the disable switch and the audit trail, and a parallel table
/// holding the same person would be one more thing to keep in step for no
/// behaviour we need. Revisit only if a reseller ever needs to exist
/// before having a login, or to have several.
model ResellerTokenBalance {
  id          String           @id @default(uuid())
  adminUserId String
  adminUser   AdminUser        @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  planId      String
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])

  /// Never negative. Spending is a single conditional UPDATE with a
  /// `balance > 0` guard rather than a read then a write -- the same race
  /// the voucher redemption counter already avoids, and without the guard
  /// two concurrent generates would both see 1 and both succeed.
  balance Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per reseller per plan; the pair is the natural key and the
  /// constraint is what makes an upsert on grant safe.
  @@unique([adminUserId, planId])
  @@index([planId])
  @@map("reseller_token_balances")
}

model Customer {
  id                             String         @id @default(uuid())
  email                          String         @unique
  passwordHash                   String
  telegramId                     String?
  referralCode                   String?        @unique
  status                         CustomerStatus @default(ACTIVE)
  // Refresh-token revocation counter, same purpose/pattern as
  // AdminUser.tokenVersion -- bumping it invalidates every outstanding
  // customer refresh token at once (logout-all-sessions).
  tokenVersion                   Int            @default(0)
  // null = unverified. Set by POST /customer-auth/verify-email or
  // /verify-email-code. No VPN access (trial or paid) is granted before
  // this is set -- see M16's "Customer Self-Signup + Free Trial Mode"
  // gating decision, 2026-07-24.
  emailVerifiedAt                DateTime?
  // Short human-enterable alternative to the verify-email link/token --
  // added 2026-07-24 after live testing showed the token (a full JWT) is
  // both unusable to type by hand and prone to breaking email HTML
  // layout when displayed. Cleared once used or superseded by a resend.
  emailVerificationCode          String?
  emailVerificationCodeExpiresAt DateTime?

  // Same reasoning as the verification code above, for the same reason.
  // Reset used to be a link carrying a JWT, which a desktop app cannot
  // receive reliably -- webmail strips custom URI schemes, which is the
  // bug that gave verification its code path in the first place. A
  // locked-out customer needs something they can read off the screen and
  // type. Cleared once used or superseded by another request.
  passwordResetCode          String?
  passwordResetCodeExpiresAt DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  // Who invited them, if anyone. Set once at signup from the referral
  // code they typed and never changed afterwards -- a referral is a
  // fact about how an account came to exist, and letting it move later
  // would make the reward arithmetic below rewritable after the fact.
  referredByCustomerId String?

  subscriptions Subscription[]
  transactions  PaymentTransaction[]
  invoices      Invoice[]

  referredBy         Customer?           @relation("CustomerReferrals", fields: [referredByCustomerId], references: [id])
  referrals          Customer[]          @relation("CustomerReferrals")
  referralRewards    ReferralReward[]    @relation("ReferralRewardsEarned")
  referralCredits    ReferralCredit[]    @relation("ReferralCreditsGiven")
  voucherRedemptions VoucherRedemption[]
  supportTickets     SupportTicket[]
  clientAttempts     ClientAttempt[]

  @@index([referredByCustomerId])
  @@map("customers")
}

// ---------------------------------------------------------------------------
// Plans & Subscriptions
// ---------------------------------------------------------------------------

model SubscriptionPlan {
  id                       String     @id @default(uuid())
  name                     String
  /// Null means unlimited traffic.
  ///
  /// Nullable rather than a sentinel like 0 or a huge number: the whole
  /// product now has two shapes of plan, and a relay through an Iranian
  /// VPS is metered precisely because that VPS's own traffic allowance
  /// is small. "No cap" and "a cap that happens to be big" are
  /// different facts, and a sentinel makes every comparison site
  /// silently answer the wrong one.
  dataCapBytes             BigInt?
  durationDays             Int
  priceUsd                 Decimal    @db.Decimal(10, 2)
  maxConcurrentConnections Int?
  // Per-user speed caps in megabits per second, applied on the node to
  // every ProtocolUser provisioned on this plan. Null means uncapped,
  // which is what every existing plan stays.
  //
  // Mbit/s rather than bytes/s because that is the unit the operator
  // thinks and sells in ("100 Mbit plan"), and the unit tc takes.
  // Up and down are separate because asymmetric plans are normal.
  maxDownloadMbps          Int?
  maxUploadMbps            Int?
  protocolsAllowed         Protocol[]
  isActive                 Boolean    @default(true)
  // Which Route a customer purchasing this plan gets provisioned on --
  // same v1 simplification as FreeTrialSettings.trialRouteId (one
  // admin-configured default, no per-purchase server picker yet). Used
  // by BillingService.confirmPayment() to provision the first
  // ProtocolUser once payment actually clears -- see
  // apps/backend/src/modules/billing/billing.service.ts.
  /// When true this plan is served ONLY by relayed Routes -- ones with
  /// an exit config, i.e. traffic that crosses an Iran-reachable relay
  /// and then an exit abroad. Ultimate is sold on exactly that path, so
  /// a direct route would be a different product wearing its name.
  ///
  /// The inverse is enforced too: a plan WITHOUT this flag never picks
  /// up a relayed route. That is the expensive direction -- relayed
  /// traffic crosses two servers and the Iran side costs more per
  /// gigabyte, so quietly provisioning every customer onto it would be
  /// paying twice to serve people who never asked for it.
  relayOnly Boolean @default(false)

  defaultRouteId           String?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  subscriptions     Subscription[]
  freeTrialSettings FreeTrialSettings[]
  referralSettings  ReferralSettings[]
  defaultRoute      Route?                 @relation(fields: [defaultRouteId], references: [id])
  Voucher           Voucher[]
  resellerBalances  ResellerTokenBalance[]

  @@map("subscription_plans")
}

model Subscription {
  id                   String             @id @default(uuid())
  customerId           String
  planId               String
  primaryNodeId        String?
  status               SubscriptionStatus @default(ACTIVE)
  startAt              DateTime           @default(now())
  expireAt             DateTime
  /// Snapshot of the plan's cap at purchase, so editing a plan later
  /// does not rewrite what an existing customer bought. Null means
  /// unlimited, same as on the plan.
  dataCapBytes         BigInt?
  dataUsedBytes        BigInt             @default(0)
  autoRenew            Boolean            @default(false)
  // Set once the low-data-remaining warning email has been sent for the
  // current billing period, so the sweep that checks for it fires only
  // once. Reset to null on renewal (BillingService.renewSubscription()).
  lowDataWarningSentAt DateTime?
  // Same "already warned" pattern for the subscription-expiring-soon
  // email, reset on renewal alongside the field above.
  expiryWarningSentAt  DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  customer          Customer             @relation(fields: [customerId], references: [id])
  plan              SubscriptionPlan     @relation(fields: [planId], references: [id])
  primaryNode       Node?                @relation(fields: [primaryNodeId], references: [id])
  protocolUsers     ProtocolUser[]
  usageRecords      UsageRecord[]
  transactions      PaymentTransaction[]
  invoices          Invoice[]
  referralReward    ReferralReward?
  voucherRedemption VoucherRedemption?

  @@index([customerId])
  @@index([status])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Nodes & Protocols
// ---------------------------------------------------------------------------

model Node {
  id              String     @id @default(uuid())
  name            String
  role            NodeRole   @default(STANDALONE)
  region          String
  publicIp        String
  status          NodeStatus @default(PENDING)
  lastHeartbeatAt DateTime?
  agentVersion    String?
  agentPubKey     String?    @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  protocolConfigs  ProtocolConfig[]
  protocolUsers    ProtocolUser[]
  agentCommands    AgentCommand[]
  usageRecords     UsageRecord[]
  subscriptions    Subscription[]
  enrollmentTokens EnrollmentToken[]

  @@map("nodes")
}

model ProtocolConfig {
  id               String            @id @default(uuid())
  nodeId           String
  protocol         Protocol
  listenPort       Int
  // How the protocol is carried, and what it is wrapped in.
  //
  // Separate from `protocol` because they are genuinely independent: the
  // same VLESS can run raw over TCP, inside a WebSocket, or over gRPC,
  // and be secured by REALITY, a real certificate, or nothing. Encoding
  // each combination as its own Protocol member would multiply the enum
  // for no gain -- XRAY_VLESS_REALITY already conflates two of these
  // three dimensions, which is why adding a WebSocket variant had
  // nowhere to go.
  //
  // Defaults reproduce exactly what every existing row already does, so
  // this migration changes no behaviour: WireGuard and OpenVPN are
  // TCP/NONE as far as this model is concerned (their own transports are
  // not configurable here), and the one Xray config in production is
  // TCP + REALITY.
  transport        Transport         @default(TCP)
  security         TransportSecurity @default(NONE)
  publicParamsJson Json
  isEnabled        Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  node          Node           @relation(fields: [nodeId], references: [id])
  protocolUsers ProtocolUser[]
  routeEntries  Route[]        @relation("RouteEntry")
  routeExits    Route[]        @relation("RouteExit")

  /// Transport is part of the identity, not an attribute of it.
  ///
  /// Without it this said a node may offer a protocol on a port exactly
  /// once, which contradicts the whole reason `transport` exists: VLESS
  /// over TLS and the same VLESS inside a WebSocket deliberately share
  /// one port and one certificate, routed apart by request path. The
  /// constraint predates the column and was never revisited, so
  /// registering the WebSocket config failed on a real node -- caught by
  /// deploying it, not by any test.
  @@unique([nodeId, protocol, listenPort, transport])
  @@map("protocol_configs")
}

// A customer-facing "server" choice: pairs a client-facing entry
// ProtocolConfig (any protocol, on any node) with an optional exit
// ProtocolConfig (must be Xray-based, on an EXIT node). No exit = direct
// route (client connects straight to the entry node, as in M2-M4). Exit
// set = relayed route -- the entry node's agent forwards traffic to the
// exit over one shared VLESS tunnel (uplinkCredentialsJson), so end
// customers are still only ever provisioned on the entry engine. See the
// "Multi-Hop Relay Chaining" section of the architecture plan.
model Route {
  id                    String   @id @default(uuid())
  name                  String
  entryProtocolConfigId String
  exitProtocolConfigId  String?
  uplinkCredentialsJson String?
  isEnabled             Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  entryProtocolConfig ProtocolConfig      @relation("RouteEntry", fields: [entryProtocolConfigId], references: [id])
  exitProtocolConfig  ProtocolConfig?     @relation("RouteExit", fields: [exitProtocolConfigId], references: [id])
  protocolUsers       ProtocolUser[]
  freeTrialSettings   FreeTrialSettings[]
  defaultForPlans     SubscriptionPlan[]

  @@map("routes")
}

model ProtocolUser {
  id               String             @id @default(uuid())
  subscriptionId   String
  routeId          String
  nodeId           String
  protocolConfigId String
  protocol         Protocol
  externalUserId   String
  credentialsJson  String // encrypted at rest (application-level envelope encryption)
  status           ProtocolUserStatus @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  subscription   Subscription   @relation(fields: [subscriptionId], references: [id])
  route          Route          @relation(fields: [routeId], references: [id])
  node           Node           @relation(fields: [nodeId], references: [id])
  protocolConfig ProtocolConfig @relation(fields: [protocolConfigId], references: [id])
  usageRecords   UsageRecord[]

  @@unique([nodeId, protocol, externalUserId])
  @@index([subscriptionId])
  @@index([routeId])
  @@map("protocol_users")
}

// ---------------------------------------------------------------------------
// Usage
// ---------------------------------------------------------------------------

model UsageRecord {
  id String @id @default(uuid())

  // Nullable, and cleared rather than cascaded when the ProtocolUser goes
  // away. A ProtocolUser is torn down routinely -- switching servers
  // deletes and recreates one -- but the usage it accrued is billing
  // history and must outlive it. As a required FK this blocked the
  // delete outright, so switching location failed with a 500 for any
  // customer who had actually used their connection. subscriptionId and
  // nodeId still identify who used what and where.
  protocolUserId String?
  subscriptionId String
  nodeId         String
  periodStart    DateTime
  periodEnd      DateTime
  bytesUp        BigInt
  bytesDown      BigInt
  reportedAt     DateTime @default(now())

  protocolUser ProtocolUser? @relation(fields: [protocolUserId], references: [id], onDelete: SetNull)
  subscription Subscription  @relation(fields: [subscriptionId], references: [id])
  node         Node          @relation(fields: [nodeId], references: [id])

  @@index([subscriptionId, reportedAt])
  @@index([nodeId, reportedAt])
  @@map("usage_records")
}

// ---------------------------------------------------------------------------
// Enrollment
// ---------------------------------------------------------------------------

model EnrollmentToken {
  id               String                @id @default(uuid())
  nodeId           String?
  tokenHash        String                @unique
  status           EnrollmentTokenStatus @default(PENDING)
  expiresAt        DateTime
  createdByAdminId String
  createdAt        DateTime              @default(now())
  claimedAt        DateTime?

  node           Node?     @relation(fields: [nodeId], references: [id])
  createdByAdmin AdminUser @relation(fields: [createdByAdminId], references: [id])

  @@map("enrollment_tokens")
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  ISSUED
  PAID
  OVERDUE
  VOID
}

/// A billing document, issued when a charge becomes due.
///
/// Deliberately not a view over PaymentTransaction: an invoice is a
/// historical record and must not change when the thing it describes
/// does. planNameSnapshot and lineItemsJson are copied at issue time so
/// renaming or deleting a plan later cannot silently rewrite what a
/// customer was billed.
///
/// Most invoices here are paid the moment they're issued -- this product
/// is prepaid and settles at purchase, so an invoice is closer to a
/// receipt than a demand for payment. dueAt is null for those. A
/// genuinely outstanding invoice only arises for slow-settling crypto or,
/// later, reseller terms.
model Invoice {
  id                   String        @id @default(uuid())
  /// Human-readable and gapless, from a Postgres sequence rather than a
  /// count of existing rows -- concurrent issuance would otherwise hand
  /// two invoices the same number.
  invoiceNumber        String        @unique
  customerId           String
  subscriptionId       String?
  paymentTransactionId String?       @unique
  planNameSnapshot     String
  amountUsd            Decimal       @db.Decimal(10, 2)
  currency             String
  status               InvoiceStatus @default(ISSUED)
  periodStart          DateTime
  periodEnd            DateTime
  issuedAt             DateTime      @default(now())
  dueAt                DateTime?
  paidAt               DateTime?
  lineItemsJson        Json

  customer           Customer            @relation(fields: [customerId], references: [id])
  subscription       Subscription?       @relation(fields: [subscriptionId], references: [id])
  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])

  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

model PaymentTransaction {
  id                String          @id @default(uuid())
  customerId        String
  subscriptionId    String?
  provider          PaymentProvider
  providerRef       String
  amountUsd         Decimal         @db.Decimal(10, 2)
  currency          String
  status            PaymentStatus   @default(PENDING)
  rawWebhookPayload Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  invoice      Invoice?

  @@unique([provider, providerRef])
  @@index([customerId])
  @@map("payment_transactions")
}

// ---------------------------------------------------------------------------
// Audit & Agent command outbox
// ---------------------------------------------------------------------------

// actorId is intentionally not a foreign key: actorType determines which
// table it points into (AdminUser.id, Node.id for AGENT, or a fixed
// "system" sentinel), so it can't be modeled as a single Prisma relation.
model AuditLog {
  id         String    @id @default(uuid())
  actorType  ActorType
  actorId    String?
  action     String
  entityType String
  entityId   String
  beforeJson Json?
  afterJson  Json?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

/// What a client was trying to do when it reported in.
enum ClientAttemptKind {
  REGISTER
  SIGN_IN
  CONNECT
}

/// How it went, in the app's own vocabulary rather than an HTTP status.
///
/// These are the distinctions that actually change what an operator does.
/// "Reached the server and it said no" and "never reached the server" look
/// identical to a customer and mean opposite things to us.
enum ClientAttemptOutcome {
  /// Worked.
  SUCCESS
  /// The control plane could not be reached at all -- every endpoint
  /// failed or timed out. The signature of a filtered address.
  CONTROL_PLANE_UNREACHABLE
  /// The server answered and refused: wrong password, unverified email,
  /// quota exhausted.
  REJECTED
  /// A tunnel came up but no traffic crossed it. The failure the egress
  /// check exists to catch, and the one a customer misreads as "slow".
  NOT_CARRYING_TRAFFIC
  /// The engine itself refused to start.
  ENGINE_FAILED
  /// The customer declined the OS permission prompt.
  PERMISSION_DENIED
  /// Something else, with the detail in `reason`.
  OTHER
}

/// One reported attempt by a client, for watching a beta in the places we
/// cannot see.
///
/// Every failure during this beta cost a screenshot and a round trip to
/// diagnose -- a tablet crashing, a friend unable to register because the
/// panel's address was filtered, a protocol blocked by one ISP but not
/// another. The app already computes all of it: the failover ladder knows
/// which rungs it tried, the egress check knows whether traffic actually
/// moved, and the endpoint list knows which address answered. It showed
/// that to the customer and threw it away.
///
/// Deliberately not tied to a customer. The most valuable reports are the
/// ones from somebody who could not sign in, so the endpoint accepts
/// anonymous submissions -- which is also why every field here is bounded
/// and the whole table is swept on a short retention window.
model ClientAttempt {
  id      String               @id @default(uuid())
  kind    ClientAttemptKind
  outcome ClientAttemptOutcome

  /// Set only when the client had a session. Null for the register and
  /// sign-in failures, which are the ones worth having.
  customerId String?

  /// "windows" | "android", and the app version, so a fault can be tied
  /// to a release rather than guessed at.
  platform   String
  appVersion String

  /// For a connect: what was attempted and what it settled on.
  routeId      String?
  protocol     String?
  /// Which rung each ladder attempt reached, newest run only. Bounded on
  /// write; this is a diagnosis aid, not an archive.
  attemptsJson Json?

  /// Which control-plane address answered, if any. This alone would have
  /// shown the CDN domain being refused before a packet ever left.
  apiEndpoint String?

  /// The app's own error text, truncated. Free-form on purpose: the
  /// enum above is for filtering, this is for understanding.
  reason String?

  /// Where the report came from. Personal data about people in a country
  /// where that matters, so it is kept briefly and joined to nothing.
  ip String?

  /// When the client says it happened, as opposed to when we received it.
  ///
  /// Not a refinement -- without it the most valuable bucket is a lie. A
  /// client that could not reach the control plane cannot report that it
  /// could not reach the control plane, so it queues and sends on the next
  /// contact, which may be hours later. Stamping those "just now" would
  /// make an outage look like it is happening at the moment somebody
  /// finally got back online.
  ///
  /// Client-supplied, therefore never trusted for ordering or retention:
  /// `createdAt` stays the arrival time and remains what everything sorts
  /// and sweeps by. This is shown, not relied on.
  occurredAt DateTime?

  createdAt DateTime @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([outcome, createdAt])
  @@index([customerId])
  @@map("client_attempts")
}

model AgentCommand {
  id          String             @id @default(uuid())
  nodeId      String
  type        AgentCommandType
  payloadJson Json
  status      AgentCommandStatus @default(QUEUED)
  createdAt   DateTime           @default(now())
  sentAt      DateTime?
  ackedAt     DateTime?
  error       String?

  node Node @relation(fields: [nodeId], references: [id])

  @@index([nodeId, status])
  @@map("agent_commands")
}

// ---------------------------------------------------------------------------
// Settings
// ---------------------------------------------------------------------------

// Lazily-initialized singleton (the service does findFirst(), creating one
// default row on first read if none exists) rather than a DB-level
// singleton constraint -- there's exactly one of these expected, but
// nothing else in this schema enforces true singletons either, so this
// stays consistent with the rest of the codebase's pragmatic style.
model FreeTrialSettings {
  id           String   @id @default(uuid())
  enabled      Boolean  @default(false)
  trialPlanId  String?
  trialRouteId String?
  updatedAt    DateTime @updatedAt

  trialPlan  SubscriptionPlan? @relation(fields: [trialPlanId], references: [id])
  trialRoute Route?            @relation(fields: [trialRouteId], references: [id])

  @@map("free_trial_settings")
}

// Same lazily-initialized-singleton shape as FreeTrialSettings above.
// Configured via a new admin-only panel Settings card (M16) -- the
// operator's own SMTP server, not a transactional-email API provider.
// passwordEncrypted reuses ProtocolUser's exact AES-256-GCM envelope
// scheme (see modules/protocol-users/credentials-crypto.ts) rather than a
// new crypto scheme; the raw password is never logged or returned by any
// API response.
/// Payment provider credentials, entered in the panel rather than baked
/// into environment variables at deploy time.
///
/// Same lazily-initialised singleton shape as EmailSettings: the service
/// findFirst()s and creates one default row if none exists.
///
/// Secrets are encrypted at rest with the same AES-256-GCM helper that
/// protects VPN credentials -- an API key that can move money is at least
/// as sensitive as one that grants a tunnel. Only the publishable key is
/// stored in the clear, because it is published by definition.
model PaymentSettings {
  id String @id @default(uuid())

  /// Cards. Disabled until a secret key is present, so a half-filled form
  /// never leaves customers with a button that fails.
  stripeEnabled                Boolean @default(false)
  stripePublishableKey         String?
  stripeSecretKeyEncrypted     String?
  stripeWebhookSecretEncrypted String?

  /// Crypto.
  nowPaymentsEnabled            Boolean @default(false)
  nowPaymentsApiKeyEncrypted    String?
  nowPaymentsIpnSecretEncrypted String?

  /// Crypto, second provider. Added ALONGSIDE NowPayments rather than
  /// replacing it: NowPayments enforces a per-currency minimum above the
  /// cheapest plan, so a 3.99 subscription could not be paid in crypto at
  /// all. Both run until a real Plisio payment is proven end to end, and
  /// existing PaymentTransaction rows still reference the old provider.
  ///
  /// No IPN-secret field on purpose: Plisio signs callbacks with the API
  /// key itself, unlike NowPayments which uses a separate secret.
  plisioEnabled         Boolean @default(false)
  plisioApiKeyEncrypted String?

  updatedAt DateTime @updatedAt

  @@map("payment_settings")
}

model EmailSettings {
  id                String   @id @default(uuid())
  enabled           Boolean  @default(false)
  host              String?
  port              Int?
  secure            Boolean  @default(false)
  username          String?
  passwordEncrypted String?
  fromAddress       String?
  updatedAt         DateTime @updatedAt

  @@map("email_settings")
}

// ---------------------------------------------------------------------------
// Referral program (see docs and ReferralsService for the reward rules)
// ---------------------------------------------------------------------------

/// Same lazily-initialized-singleton shape as FreeTrialSettings.
///
/// Every threshold is configurable rather than hardcoded, because the
/// right numbers are a commercial decision the operator will want to
/// tune once real referrals exist -- and changing them should not need a
/// deployment.
model ReferralSettings {
  id      String  @id @default(uuid())
  enabled Boolean @default(false)

  /// Which plan a free month is granted on. Deliberately the operator's
  /// choice rather than whatever plan the inviter happens to be on: the
  /// reward is a gift from the business, and the business decides what
  /// it is worth.
  rewardPlanId String?
  rewardPlan   SubscriptionPlan? @relation(fields: [rewardPlanId], references: [id])

  /// One reward when a single invited customer reaches this many
  /// cumulative paid months.
  loyalFriendMonths Int @default(3)
  /// Or one reward when this many distinct invited customers have each
  /// reached `friendMonths`. Whichever condition is met first.
  friendsRequired   Int @default(3)
  friendMonths      Int @default(1)

  /// How long the granted subscription runs. Held separately from the
  /// reward plan's own durationDays so "a free month" stays a month even
  /// if the operator points the reward at an annual plan.
  rewardDays Int @default(30)

  updatedAt DateTime @updatedAt

  @@map("referral_settings")
}

enum ReferralRewardReason {
  /// One invited customer stayed long enough on their own.
  LOYAL_FRIEND
  /// Several invited customers each reached the smaller threshold.
  SEVERAL_FRIENDS
}

/// A free month that has actually been granted.
///
/// Recorded rather than recomputed, for the reason every ledger is: the
/// thresholds are admin-editable, so a reward earned under the old
/// numbers must not evaporate when they change.
model ReferralReward {
  id         String               @id @default(uuid())
  referrerId String
  referrer   Customer             @relation("ReferralRewardsEarned", fields: [referrerId], references: [id])
  reason     ReferralRewardReason

  /// Which invited customers paid for this reward and how many of their
  /// months it consumed -- the audit trail for why it was granted, and
  /// the thing that makes a disputed reward answerable.
  sourceJson Json

  /// The subscription granted. Nullable because the grant can fail
  /// (no reward plan configured, provisioning error) after the reward
  /// itself has been decided, and losing the record of the decision
  /// would let the same months earn a second reward on the next sweep.
  subscriptionId String?       @unique
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  rewardDays Int
  grantedAt  DateTime @default(now())

  @@index([referrerId])
  @@map("referral_rewards")
}

/// How much of one invited customer's paid time has already been spent
/// on a reward.
///
/// Without this the arithmetic is not idempotent: a friend who has paid
/// for three months would earn their inviter a free month on every
/// sweep, forever. Spending is recorded against the friend rather than
/// the reward so the "months still available" question -- the one the
/// customer-facing progress bar asks -- is a single lookup.
model ReferralCredit {
  id                 String   @id @default(uuid())
  referredCustomerId String   @unique
  referredCustomer   Customer @relation("ReferralCreditsGiven", fields: [referredCustomerId], references: [id])
  monthsSpent        Int      @default(0)
  updatedAt          DateTime @updatedAt

  @@map("referral_credits")
}

// ---------------------------------------------------------------------------
// Vouchers
// ---------------------------------------------------------------------------

/// A code that grants a plan without payment.
///
/// The three kinds the operator asked for are not an enum, because they
/// are two independent limits that compose: a one-time code is
/// `maxRedemptions = 1`, an expiring one sets `expiresAt`, an unlimited
/// one leaves both open -- and a code can be both limited and expiring,
/// which an enum would have made impossible to express.
model Voucher {
  id     String           @id @default(uuid())
  /// Uppercased on write so redeeming is not case-sensitive to the
  /// customer while the unique constraint still means what it says.
  code   String           @unique
  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  /// null = no limit on how many people may redeem it.
  maxRedemptions Int?
  /// Kept as a counter as well as a row count, because the check that
  /// stops a one-time code being used twice has to be a single
  /// conditional update -- counting rows first and inserting after is
  /// exactly the race that lets two people redeem the last use.
  redeemedCount  Int  @default(0)

  /// null = never expires.
  expiresAt DateTime?
  /// Lets the operator stop a code immediately without deleting it and
  /// losing the record of who already redeemed it.
  isActive  Boolean   @default(true)
  /// Operator-facing label: which campaign or person it was cut for.
  note      String?

  /// The reseller who minted this, or null for one the operator cut
  /// directly. Every reseller query scopes on it, so a reseller can only
  /// ever see and revoke their own codes -- and it is what makes the
  /// token refund on delete safe to attribute.
  issuedByAdminId String?
  issuedBy        AdminUser? @relation("VoucherIssuer", fields: [issuedByAdminId], references: [id])

  /// Who it was emailed to, when it was emailed at all. Kept so the
  /// reseller's history list can show it and offer a resend; null for a
  /// code generated to hand over in person, which is a supported case
  /// rather than an incomplete one.
  recipientEmail String?

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  redemptions VoucherRedemption[]

  @@index([planId])
  @@index([issuedByAdminId])
  @@map("vouchers")
}

/// One customer's use of one voucher.
///
/// Recorded rather than inferred from the counter, so "who used this
/// code" is answerable -- and so the unique constraint below can stop
/// the same person redeeming the same code twice, which a counter alone
/// cannot express.
model VoucherRedemption {
  id         String   @id @default(uuid())
  voucherId  String
  voucher    Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  /// The subscription it granted. Nullable because the redemption is
  /// recorded first: losing the record would let the same code be spent
  /// again if provisioning failed halfway.
  subscriptionId String?       @unique
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  redeemedAt DateTime @default(now())

  @@unique([voucherId, customerId])
  @@index([customerId])
  @@map("voucher_redemptions")
}

// ---------------------------------------------------------------------------
// Community links
// ---------------------------------------------------------------------------

/// Where customers can find the product outside the app.
///
/// Served rather than compiled in, and that is the point: a Discord
/// invite expires, an account gets renamed, and neither should need a
/// new release of a desktop app to fix. Every field is nullable and the
/// app renders only what is filled in, so nothing here can produce a
/// button that goes nowhere.
///
/// Same lazily-created singleton shape as FreeTrialSettings.
model AppLinks {
  id           String   @id @default(uuid())
  websiteUrl   String?
  discordUrl   String?
  instagramUrl String?
  telegramUrl  String?
  updatedAt    DateTime @updatedAt

  @@map("app_links")
}

// ---------------------------------------------------------------------------
// Support
// ---------------------------------------------------------------------------

/// Whether the operator is taking new conversations.
///
/// Async tickets rather than live chat, deliberately. This is a
/// one-person operation with an away switch, so presence is a promise
/// that could not be kept -- a thread that looks like chat and does not
/// claim anyone is watching is the honest version of the same feature.
///
/// Same lazily-created singleton shape as the other settings models.
model SupportSettings {
  id               String   @id @default(uuid())
  /// Off means no *new* conversations. Existing ones stay open on
  /// purpose: cutting somebody off mid-conversation is worse than
  /// declining to start one.
  acceptingTickets Boolean  @default(false)
  /// What the app says when new conversations are closed. Null falls
  /// back to wording the app ships, so an empty setting cannot produce
  /// a blank explanation.
  awayMessage      String?
  /// Roughly how long a reply takes, shown when opening a ticket so
  /// nobody sits watching an empty thread expecting an instant answer.
  replyWithinHours Int?     @default(24)
  updatedAt        DateTime @updatedAt

  @@map("support_settings")
}

enum SupportTicketStatus {
  /// Waiting on the operator.
  OPEN
  /// The operator has replied; waiting on the customer.
  ANSWERED
  /// Done. Either side can reopen by writing again.
  RESOLVED
}

model SupportTicket {
  id         String              @id @default(uuid())
  customerId String
  customer   Customer            @relation(fields: [customerId], references: [id])
  subject    String
  status     SupportTicketStatus @default(OPEN)

  /// Denormalised so the inbox can sort and the app can show an unread
  /// dot without loading every message of every thread.
  lastMessageAt      DateTime  @default(now())
  /// Drives the app's unread marker: a reply is unread when it is newer
  /// than this. Held per side because each reads independently.
  customerLastReadAt DateTime?

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  SupportMessage[]

  @@index([customerId])
  @@index([status, lastMessageAt])
  @@map("support_tickets")
}

model SupportMessage {
  id       String        @id @default(uuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// Which side wrote it, rather than a relation to AdminUser. An admin
  /// account can be deleted and the conversation still has to read
  /// correctly afterwards -- and the customer is only ever shown
  /// "Support", never which person answered.
  fromAdmin Boolean
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("support_messages")
}
