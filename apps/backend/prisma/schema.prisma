generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AdminRole {
  SUPERADMIN
  SUPPORT
  BILLING
}

enum CustomerStatus {
  ACTIVE
  DISABLED
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum NodeRole {
  RELAY
  EXIT
  STANDALONE
}

enum NodeStatus {
  PENDING
  ONLINE
  OFFLINE
  DISABLED
}

enum Protocol {
  XRAY_VLESS_REALITY
  XRAY_VMESS
  XRAY_TROJAN
  WIREGUARD
  OPENVPN
}

enum ProtocolUserStatus {
  ACTIVE
  DISABLED
}

enum EnrollmentTokenStatus {
  PENDING
  CLAIMED
  REVOKED
  EXPIRED
}

enum PaymentProvider {
  STRIPE
  NOWPAYMENTS
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum ActorType {
  ADMIN
  SYSTEM
  AGENT
}

enum AgentCommandType {
  CREATE_USER
  UPDATE_USER
  DELETE_USER
  DISABLE_USER
  ENABLE_USER
  SET_QUOTA
  SYNC
  CONFIGURE_ROUTE
  REMOVE_ROUTE
}

enum AgentCommandStatus {
  QUEUED
  SENT
  ACKED
  FAILED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(SUPPORT)
  // Set as soon as /auth/mfa/setup generates a candidate secret, but not
  // enforced at login until mfaEnabled flips true via /auth/mfa/enable --
  // otherwise a QR-scan typo during setup could lock the admin out before
  // they've ever confirmed the app on their phone actually works.
  mfaSecret    String?
  mfaEnabled   Boolean   @default(false)
  tokenVersion Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  enrollmentTokens EnrollmentToken[]

  @@map("admin_users")
}

model Customer {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  telegramId    String?
  referralCode  String?        @unique
  status        CustomerStatus @default(ACTIVE)
  // Refresh-token revocation counter, same purpose/pattern as
  // AdminUser.tokenVersion -- bumping it invalidates every outstanding
  // customer refresh token at once (logout-all-sessions).
  tokenVersion  Int            @default(0)
  // null = unverified. Set by POST /customer-auth/verify-email or
  // /verify-email-code. No VPN access (trial or paid) is granted before
  // this is set -- see M16's "Customer Self-Signup + Free Trial Mode"
  // gating decision, 2026-07-24.
  emailVerifiedAt DateTime?
  // Short human-enterable alternative to the verify-email link/token --
  // added 2026-07-24 after live testing showed the token (a full JWT) is
  // both unusable to type by hand and prone to breaking email HTML
  // layout when displayed. Cleared once used or superseded by a resend.
  emailVerificationCode          String?
  emailVerificationCodeExpiresAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  subscriptions Subscription[]
  transactions  PaymentTransaction[]
  invoices      Invoice[]

  @@map("customers")
}

// ---------------------------------------------------------------------------
// Plans & Subscriptions
// ---------------------------------------------------------------------------

model SubscriptionPlan {
  id                       String   @id @default(uuid())
  name                     String
  dataCapBytes             BigInt
  durationDays             Int
  priceUsd                 Decimal  @db.Decimal(10, 2)
  maxConcurrentConnections Int?
  // Per-user speed caps in megabits per second, applied on the node to
  // every ProtocolUser provisioned on this plan. Null means uncapped,
  // which is what every existing plan stays.
  //
  // Mbit/s rather than bytes/s because that is the unit the operator
  // thinks and sells in ("100 Mbit plan"), and the unit tc takes.
  // Up and down are separate because asymmetric plans are normal.
  maxDownloadMbps          Int?
  maxUploadMbps            Int?
  protocolsAllowed         Protocol[]
  isActive                 Boolean  @default(true)
  // Which Route a customer purchasing this plan gets provisioned on --
  // same v1 simplification as FreeTrialSettings.trialRouteId (one
  // admin-configured default, no per-purchase server picker yet). Used
  // by BillingService.confirmPayment() to provision the first
  // ProtocolUser once payment actually clears -- see
  // apps/backend/src/modules/billing/billing.service.ts.
  defaultRouteId           String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  subscriptions      Subscription[]
  freeTrialSettings  FreeTrialSettings[]
  defaultRoute       Route?          @relation(fields: [defaultRouteId], references: [id])

  @@map("subscription_plans")
}

model Subscription {
  id             String              @id @default(uuid())
  customerId     String
  planId         String
  primaryNodeId  String?
  status         SubscriptionStatus  @default(ACTIVE)
  startAt        DateTime            @default(now())
  expireAt       DateTime
  dataCapBytes   BigInt
  dataUsedBytes  BigInt              @default(0)
  autoRenew      Boolean             @default(false)
  // Set once the low-data-remaining warning email has been sent for the
  // current billing period, so the sweep that checks for it fires only
  // once. Reset to null on renewal (BillingService.renewSubscription()).
  lowDataWarningSentAt DateTime?
  // Same "already warned" pattern for the subscription-expiring-soon
  // email, reset on renewal alongside the field above.
  expiryWarningSentAt  DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  customer     Customer           @relation(fields: [customerId], references: [id])
  plan         SubscriptionPlan   @relation(fields: [planId], references: [id])
  primaryNode  Node?              @relation(fields: [primaryNodeId], references: [id])
  protocolUsers ProtocolUser[]
  usageRecords  UsageRecord[]
  transactions  PaymentTransaction[]
  invoices      Invoice[]

  @@index([customerId])
  @@index([status])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Nodes & Protocols
// ---------------------------------------------------------------------------

model Node {
  id              String     @id @default(uuid())
  name            String
  role            NodeRole   @default(STANDALONE)
  region          String
  publicIp        String
  status          NodeStatus @default(PENDING)
  lastHeartbeatAt DateTime?
  agentVersion    String?
  agentPubKey     String?    @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  protocolConfigs  ProtocolConfig[]
  protocolUsers    ProtocolUser[]
  agentCommands    AgentCommand[]
  usageRecords     UsageRecord[]
  subscriptions    Subscription[]
  enrollmentTokens EnrollmentToken[]

  @@map("nodes")
}

model ProtocolConfig {
  id               String   @id @default(uuid())
  nodeId           String
  protocol         Protocol
  listenPort       Int
  publicParamsJson Json
  isEnabled        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  node          Node           @relation(fields: [nodeId], references: [id])
  protocolUsers ProtocolUser[]
  routeEntries  Route[]        @relation("RouteEntry")
  routeExits    Route[]        @relation("RouteExit")

  @@unique([nodeId, protocol, listenPort])
  @@map("protocol_configs")
}

// A customer-facing "server" choice: pairs a client-facing entry
// ProtocolConfig (any protocol, on any node) with an optional exit
// ProtocolConfig (must be Xray-based, on an EXIT node). No exit = direct
// route (client connects straight to the entry node, as in M2-M4). Exit
// set = relayed route -- the entry node's agent forwards traffic to the
// exit over one shared VLESS tunnel (uplinkCredentialsJson), so end
// customers are still only ever provisioned on the entry engine. See the
// "Multi-Hop Relay Chaining" section of the architecture plan.
model Route {
  id                    String   @id @default(uuid())
  name                  String
  entryProtocolConfigId String
  exitProtocolConfigId  String?
  uplinkCredentialsJson String?
  isEnabled             Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  entryProtocolConfig ProtocolConfig  @relation("RouteEntry", fields: [entryProtocolConfigId], references: [id])
  exitProtocolConfig  ProtocolConfig? @relation("RouteExit", fields: [exitProtocolConfigId], references: [id])
  protocolUsers       ProtocolUser[]
  freeTrialSettings   FreeTrialSettings[]
  defaultForPlans     SubscriptionPlan[]

  @@map("routes")
}

model ProtocolUser {
  id               String             @id @default(uuid())
  subscriptionId   String
  routeId          String
  nodeId           String
  protocolConfigId String
  protocol         Protocol
  externalUserId   String
  credentialsJson  String // encrypted at rest (application-level envelope encryption)
  status           ProtocolUserStatus @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  subscription   Subscription   @relation(fields: [subscriptionId], references: [id])
  route          Route          @relation(fields: [routeId], references: [id])
  node           Node           @relation(fields: [nodeId], references: [id])
  protocolConfig ProtocolConfig @relation(fields: [protocolConfigId], references: [id])
  usageRecords   UsageRecord[]

  @@unique([nodeId, protocol, externalUserId])
  @@index([subscriptionId])
  @@index([routeId])
  @@map("protocol_users")
}

// ---------------------------------------------------------------------------
// Usage
// ---------------------------------------------------------------------------

model UsageRecord {
  id String @id @default(uuid())

  // Nullable, and cleared rather than cascaded when the ProtocolUser goes
  // away. A ProtocolUser is torn down routinely -- switching servers
  // deletes and recreates one -- but the usage it accrued is billing
  // history and must outlive it. As a required FK this blocked the
  // delete outright, so switching location failed with a 500 for any
  // customer who had actually used their connection. subscriptionId and
  // nodeId still identify who used what and where.
  protocolUserId String?
  subscriptionId String
  nodeId         String
  periodStart    DateTime
  periodEnd      DateTime
  bytesUp        BigInt
  bytesDown      BigInt
  reportedAt     DateTime @default(now())

  protocolUser ProtocolUser? @relation(fields: [protocolUserId], references: [id], onDelete: SetNull)
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  node         Node         @relation(fields: [nodeId], references: [id])

  @@index([subscriptionId, reportedAt])
  @@index([nodeId, reportedAt])
  @@map("usage_records")
}

// ---------------------------------------------------------------------------
// Enrollment
// ---------------------------------------------------------------------------

model EnrollmentToken {
  id              String                @id @default(uuid())
  nodeId          String?
  tokenHash       String                @unique
  status          EnrollmentTokenStatus @default(PENDING)
  expiresAt       DateTime
  createdByAdminId String
  createdAt       DateTime              @default(now())
  claimedAt       DateTime?

  node           Node?     @relation(fields: [nodeId], references: [id])
  createdByAdmin AdminUser @relation(fields: [createdByAdminId], references: [id])

  @@map("enrollment_tokens")
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  ISSUED
  PAID
  OVERDUE
  VOID
}

/// A billing document, issued when a charge becomes due.
///
/// Deliberately not a view over PaymentTransaction: an invoice is a
/// historical record and must not change when the thing it describes
/// does. planNameSnapshot and lineItemsJson are copied at issue time so
/// renaming or deleting a plan later cannot silently rewrite what a
/// customer was billed.
///
/// Most invoices here are paid the moment they're issued -- this product
/// is prepaid and settles at purchase, so an invoice is closer to a
/// receipt than a demand for payment. dueAt is null for those. A
/// genuinely outstanding invoice only arises for slow-settling crypto or,
/// later, reseller terms.
model Invoice {
  id                   String        @id @default(uuid())
  /// Human-readable and gapless, from a Postgres sequence rather than a
  /// count of existing rows -- concurrent issuance would otherwise hand
  /// two invoices the same number.
  invoiceNumber        String        @unique
  customerId           String
  subscriptionId       String?
  paymentTransactionId String?       @unique
  planNameSnapshot     String
  amountUsd            Decimal       @db.Decimal(10, 2)
  currency             String
  status               InvoiceStatus @default(ISSUED)
  periodStart          DateTime
  periodEnd            DateTime
  issuedAt             DateTime      @default(now())
  dueAt                DateTime?
  paidAt               DateTime?
  lineItemsJson        Json

  customer           Customer            @relation(fields: [customerId], references: [id])
  subscription       Subscription?       @relation(fields: [subscriptionId], references: [id])
  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])

  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

model PaymentTransaction {
  id                 String          @id @default(uuid())
  customerId         String
  subscriptionId     String?
  provider           PaymentProvider
  providerRef        String
  amountUsd          Decimal         @db.Decimal(10, 2)
  currency           String
  status             PaymentStatus   @default(PENDING)
  rawWebhookPayload  Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  invoice      Invoice?

  @@unique([provider, providerRef])
  @@index([customerId])
  @@map("payment_transactions")
}

// ---------------------------------------------------------------------------
// Audit & Agent command outbox
// ---------------------------------------------------------------------------

// actorId is intentionally not a foreign key: actorType determines which
// table it points into (AdminUser.id, Node.id for AGENT, or a fixed
// "system" sentinel), so it can't be modeled as a single Prisma relation.
model AuditLog {
  id         String    @id @default(uuid())
  actorType  ActorType
  actorId    String?
  action     String
  entityType String
  entityId   String
  beforeJson Json?
  afterJson  Json?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model AgentCommand {
  id         String             @id @default(uuid())
  nodeId     String
  type       AgentCommandType
  payloadJson Json
  status     AgentCommandStatus @default(QUEUED)
  createdAt  DateTime           @default(now())
  sentAt     DateTime?
  ackedAt    DateTime?
  error      String?

  node Node @relation(fields: [nodeId], references: [id])

  @@index([nodeId, status])
  @@map("agent_commands")
}

// ---------------------------------------------------------------------------
// Settings
// ---------------------------------------------------------------------------

// Lazily-initialized singleton (the service does findFirst(), creating one
// default row on first read if none exists) rather than a DB-level
// singleton constraint -- there's exactly one of these expected, but
// nothing else in this schema enforces true singletons either, so this
// stays consistent with the rest of the codebase's pragmatic style.
model FreeTrialSettings {
  id           String   @id @default(uuid())
  enabled      Boolean  @default(false)
  trialPlanId  String?
  trialRouteId String?
  updatedAt    DateTime @updatedAt

  trialPlan  SubscriptionPlan? @relation(fields: [trialPlanId], references: [id])
  trialRoute Route?            @relation(fields: [trialRouteId], references: [id])

  @@map("free_trial_settings")
}

// Same lazily-initialized-singleton shape as FreeTrialSettings above.
// Configured via a new admin-only panel Settings card (M16) -- the
// operator's own SMTP server, not a transactional-email API provider.
// passwordEncrypted reuses ProtocolUser's exact AES-256-GCM envelope
// scheme (see modules/protocol-users/credentials-crypto.ts) rather than a
// new crypto scheme; the raw password is never logged or returned by any
// API response.
model EmailSettings {
  id                String   @id @default(uuid())
  enabled           Boolean  @default(false)
  host              String?
  port              Int?
  secure            Boolean  @default(false)
  username          String?
  passwordEncrypted String?
  fromAddress       String?
  updatedAt         DateTime @updatedAt

  @@map("email_settings")
}
