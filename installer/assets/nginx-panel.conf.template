# Managed by the NeoConnect panel installer (installer/lib/panel.sh).
# Re-run 'sudo ./installer/install.sh' -> Main Panel Server -> reconfigure
# to regenerate this file rather than hand-editing it.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Let's Encrypt HTTP-01 challenge; certbot --nginx adds the SSL
    # server block and the redirect to it automatically on top of this.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:4000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The timed download of /health/bulk (the apps' speed sample) asks
        # not to be buffered, so it is paced by the customer's line rather
        # than taken whole at this host's speed. nginx honours the header
        # here, then drops it by default (every X-Accel-* is hidden), so
        # the node API mirrors behind this hop never saw it and buffered
        # the whole stream -- the full cap per sample, pulled at datacentre
        # speed into their temp files. Passed on, so they honour it too.
        proxy_pass_header X-Accel-Buffering;
    }

    location / {
        proxy_pass http://127.0.0.1:3000/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
