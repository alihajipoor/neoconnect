# fleet.env: where `scripts/fleet/fleet` finds the hosts.
#
# Copy this file to ~/.neoxify/fleet.env (on Windows that is
# %USERPROFILE%\.neoxify\fleet.env) and fill it in there. The copy holds
# real addresses and names and must never be inside the repository: the
# tool refuses to read it from there. Every value below is a placeholder
# from the documentation ranges.
#
# Exit servers are not listed here: their addresses are read from the
# panel's database each time, through the panel host.

# --- the panel host -----------------------------------------------------
PANEL_HOST=203.0.113.5                 # its address: SSH, the agents' control port, the API mirrors' upstream
PANEL_KEY=~/.ssh/panel_key
PANEL_GRPC_PORT=50051
PANEL_ORIGIN_NAME=origin.example.net   # a name on the panel's certificate that resolves straight to it (no CDN)
PANEL_API_URL=https://origin.example.net/api
PG_CONTAINER=neoxify-postgres-1
BACKEND_CONTAINER=neoxify-backend-1

# --- exit servers -------------------------------------------------------
NODE_KEY=~/.ssh/nodes_key              # the fleet key
# Public key (one line) of a second operator machine, added to every new box. Optional.
EXTRA_AUTHORIZED_KEY_FILE=
XRAY_VERSION=v26.3.27                  # the build every server runs; change it here and in the installer together
# FLEET_AGENT_VERSION=v0.0.0           # default: the version most online servers run

# --- the two boxes inside the watched country ---------------------------
# Their own key, never the fleet key: a seized box's authorized_keys
# would otherwise identify every server.
INSIDE_KEY=~/.ssh/inside_key
RELAY_HOST=198.51.100.20               # the relay box
RELAY_NODE_NAME=relay-1                # its name in the panel
SIGNIN_HOST=198.51.100.30              # the sign-in box: holds no credential, ever
HOP_PORT_BASE=47131                    # first port of the relay hop range

# --- DNS ----------------------------------------------------------------
CF_TOKEN_FILE=~/.cloudflare/dns-token.txt
NODE_DNS_ZONE=example.org              # new servers get two random names here
CF_ZONES="example.org example.net example.com"   # every zone swept when a server is retired
# Zones at registrars the tool cannot edit. Names there are listed for the owner to delete by hand.
OTHER_REGISTRAR_ZONES="example.info"

# --- test accounts --------------------------------------------------------
# Used after the plan edit, to dial with credentials the panel issued.
TEST_DIRECT_EMAIL=owner@example.com    # on a plan that holds direct routes
TEST_RELAY_EMAIL=relay-test@example.com   # on the relay-only plan
