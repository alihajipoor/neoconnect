#!/usr/bin/env bash
# fleet: add, retire, replace and inspect VPN servers, as a checklist.
#
#   fleet precheck <ip>                         is this empty box worth building on?
#   fleet add <name> <ip> --region <r> [--dest <host:port>]
#   fleet retire <name>
#   fleet replace <old-name> <ip>
#   fleet continue <run dir> [options]          pick a stopped run up again, same command line
#   fleet status [<name>]                       read-only
#   fleet plan-check <name> [--default-to <s>]  read-only: would retiring it pass the plan guard?
#   fleet steps <precheck|add|retire|replace>   the checklist, ids and titles
#   fleet dns <list|get|create-a|delete|...>    Cloudflare helper, output masked
#
# Options for every checklist:
#   --dry-run            print every step and command, touch nothing
#   --from <step>        start at that step (and run it again if it was done)
#   --only <step>        run that one step
#   --yes                do not ask before steps that change a live host
#   --done <step,...>    done another way: only the step's verify runs, NEVER its action
#                        (an owner step: the owner did it between two runs)
#   --waive <step,...>   the owner decided to go on although that step did not pass;
#                        written to the run log, and the run ends "complete EXCEPT" it
#   --env <file>         the local address file (default ~/.neoxify/fleet.env)
#   --run <dir>          continue that run directory; --new-run starts a fresh one
#   --fresh-dump         a new database dump at the next step that needs one. A run takes
#                        ONE dump, at its first database write, and every later step reuses it
#   --use-dump <file>    this job already has a dump on the panel host (/root/db-backups/..):
#                        checked with gzip -t and used as this run's one dump
# add / replace:
#   --peer <name>        the server whose protocol set the new one must equal
#   --relay-set <set>    which free entry set on the relay box to use
#   --hop auto|yes|no    reach the new exit from the relay through the hop
#   --plans "A,B"        only these customer plans (default: every plan)
#   --no-relay, --no-plans
#   --accept-held        the owner decided to build on a box the inside test holds
#   --accept-blocked-zone, --accept-weak-dest
#   --provider-firewall  the provider puts a firewall in front of the box: add.firewall waits
#                        for the owner to open it (without it, it only prints the ports)
#   --proven-elsewhere <p,...>  wireguard, openvpn, ikev2: proven another way (the real app,
#                        through the canary plan) on this server; written to the run log
#   --canary-plan <name> the plan a new server is proven through first (default "Internal test")
# retire:
#   --default-to <name>  where a plan's default route goes when it is on this server
#
# Decisions given once (--accept-*, --hop, --dest, --proven-elsewhere, ...) are kept with
# the run and not asked for again: a stop prints the exact `fleet continue` line.
#
# Run it from Git Bash on the operator's PC. Addresses, key paths and
# names of ours come only from the local file (see fleet.env.example) or
# from the database through the panel host; nothing address-like is in
# this repository, and everything printed is masked.
#
# The human runbook is docs/runbooks/fleet.md.
#
# Most of what is set here is read by the files under lib/, and the
# linter does not follow them; hence, for the whole file:
# shellcheck disable=SC2034,SC1090,SC1091
set -uo pipefail

FLEET_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$FLEET_DIR/../.." && pwd)"
FLEET_HOME="${FLEET_HOME:-$HOME/.neoxify}"

OPT_DRY=0 OPT_YES=0 OPT_NEW_RUN=0 OPT_FROM="" OPT_ONLY="" OPT_RUN="" OPT_ENV="" OPT_FLAGS="" OPT_DONE="" OPT_WAIVE=""
OPT_PEER="" OPT_RELAY_SET="" OPT_HOP=auto OPT_PLANS="" OPT_NO_RELAY=0 OPT_NO_PLANS=0
OPT_ACCEPT_HELD=0 OPT_ACCEPT_ZONE=0 OPT_ACCEPT_DEST=0 OPT_DEFAULT_TO="" OPT_NAME=""
OPT_FRESH_DUMP=0 OPT_USE_DUMP="" OPT_PROVIDER_FW=0 OPT_PROVEN="" OPT_CANARY_PLAN="Internal test"
REGION="" DEST="" NAME="" OLD="" NEW_IP=""

usage() {
  sed -n '2,47p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  exit "${1:-2}"
}

# `fleet continue <run dir> [options]`: the command line the run was
# started with (kept in its directory), plus what is given now.
if [[ "${1:-}" == continue ]]; then
  [[ -n "${2:-}" && -d "$2" ]] || { echo "fleet continue: name a run directory (the stop message prints it)" >&2; exit 2; }
  [[ -s "$2/argv" ]] || { echo "fleet continue: $2 has no saved command line (a run from before this was added: run its command again)" >&2; exit 2; }
  mapfile -t SAVED <"$2/argv"
  dir="$2"
  shift 2
  exec bash "${BASH_SOURCE[0]}" "${SAVED[@]}" "$@" --run "$dir"
fi

ORIG_ARGS=("$@")
CMD="${1:-}"
[[ -n "$CMD" ]] || usage
shift
POS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) OPT_DRY=1 ;;
    --yes) OPT_YES=1 ;;
    --new-run) OPT_NEW_RUN=1 ;;
    --no-relay) OPT_NO_RELAY=1 ;;
    --no-plans) OPT_NO_PLANS=1 ;;
    --accept-held) OPT_ACCEPT_HELD=1 ;;
    --accept-blocked-zone) OPT_ACCEPT_ZONE=1 ;;
    --accept-weak-dest) OPT_ACCEPT_DEST=1 ;;
    --fresh-dump) OPT_FRESH_DUMP=1 ;;
    --provider-firewall) OPT_PROVIDER_FW=1 ;;
    --delete)
      # Only `fleet dns sweep ... --delete` takes it: it goes on to the DNS helper.
      [[ "$CMD" == dns ]] || { echo "fleet: unknown option $1" >&2; exit 2; }
      POS+=("$1")
      ;;
    --from | --only | --done | --waive | --run | --env | --region | --dest | --peer | --relay-set | --hop | --plans | --default-to | --name | --use-dump | --proven-elsewhere | --canary-plan)
      [[ $# -ge 2 ]] || { echo "fleet: $1 needs a value" >&2; exit 2; }
      case "$1" in
        --from) OPT_FROM="$2" ;;
        --only) OPT_ONLY="$2" ;;
        --done) OPT_DONE="${OPT_DONE:+$OPT_DONE,}$2" ;;
        --use-dump) OPT_USE_DUMP="$2" ;;
        --proven-elsewhere) OPT_PROVEN="${OPT_PROVEN:+$OPT_PROVEN,}$2" ;;
        --canary-plan) OPT_CANARY_PLAN="$2" ;;
        --waive) OPT_WAIVE="${OPT_WAIVE:+$OPT_WAIVE,}$2" ;;
        --run) OPT_RUN="$2" ;;
        --env) OPT_ENV="$2" ;;
        --region) REGION="$2" ;;
        --dest) DEST="$2" ;;
        --peer) OPT_PEER="$2" ;;
        --relay-set) OPT_RELAY_SET="$2" ;;
        --hop) OPT_HOP="$2" ;;
        --plans) OPT_PLANS="$2" ;;
        --default-to) OPT_DEFAULT_TO="$2" ;;
        --name) OPT_NAME="$2" ;;
      esac
      # A waiver, and what was proven another way, go into the run log
      # with what they name.
      case "$1" in --waive | --proven-elsewhere | --done) OPT_FLAGS+="$1 $2 " ;; *) OPT_FLAGS+="$1 " ;; esac
      shift
      ;;
    -h | --help) usage 0 ;;
    --*) echo "fleet: unknown option $1" >&2; exit 2 ;;
    *) POS+=("$1") ;;
  esac
  case "${1:-}" in --accept-* | --no-* | --yes | --fresh-dump | --provider-firewall) OPT_FLAGS+="$1 " ;; esac
  shift
done
export OPT_DRY OPT_YES

# The command line a run keeps, so that `fleet continue` and a plain
# re-run never ask again for a decision already given. One-shot options
# (which step, which run, a fresh dump) are not kept.
persistent_args() {
  local a skip=0
  for a in "${ORIG_ARGS[@]}"; do
    if [[ $skip -eq 1 ]]; then skip=0; continue; fi
    case "$a" in
      --only | --from | --done | --waive | --run | --use-dump) skip=1 ;;
      --dry-run | --new-run | --fresh-dump) ;;
      *) printf '%s\n' "$a" ;;
    esac
  done
}

# remember_args: on a new run, keep its command line. On a resumed run,
# a decision the first command gave and this one leaves out is carried
# over: the command is run again with it, once.
remember_args() {
  local f="$RUN_DIR/argv" cur missing=() u i
  dry && return 0
  cur="$(persistent_args)"
  if [[ -s "$f" && "${FLEET_REEXEC:-0}" != 1 ]]; then
    mapfile -t saved <"$f"
    for ((i = 0; i < ${#saved[@]}; i++)); do
      u="${saved[$i]}"
      [[ "$u" == --* ]] || continue
      case "$u" in
        --accept-* | --no-relay | --no-plans | --yes | --provider-firewall) grep -qxF -- "$u" <<<"$cur" || missing+=("$u") ;;
        --*)
          # an option with a value: carried only if not given again now
          if ! grep -qxF -- "$u" <<<"$cur" && [[ $((i + 1)) -lt ${#saved[@]} ]]; then missing+=("$u" "${saved[$((i + 1))]}"); fi
          i=$((i + 1))
          ;;
      esac
    done
    if [[ ${#missing[@]} -gt 0 ]]; then
      echo "Carried over from this run's first command: $(printf '%s\n' "${missing[@]}" | grep -- '^--' | tr '\n' ' ')"
      FLEET_REEXEC=1 exec bash "${BASH_SOURCE[0]}" "${ORIG_ARGS[@]}" "${missing[@]}" --run "$RUN_DIR"
    fi
  fi
  printf '%s\n' "$cur" >"$f"
  chmod 600 "$f" 2>/dev/null || true
}

# shellcheck source=lib/engine.sh
source "$FLEET_DIR/lib/engine.sh"

name_ok() { [[ "$1" =~ ^[a-z]+(-[a-z]+)*-[0-9]+$ ]] || die "'$1' is not a server name (expected like country-3)"; }
ip_ok() { [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || die "'$1' is not an IPv4 address"; }

# ---------------------------------------------------------------- local file

load_env() {
  local f="${OPT_ENV:-${FLEET_ENV:-$FLEET_HOME/fleet.env}}" k
  [[ -f "$f" ]] || die "no address file at $f. Copy scripts/fleet/fleet.env.example there and fill it in (it never goes into the repository)."
  case "$(cd "$(dirname "$f")" && pwd)/" in
    "$REPO_ROOT"/scripts/fleet/test/*) ;;
    "$REPO_ROOT"/*) die "the address file is inside the repository ($f). Move it out: this repository is public." ;;
  esac
  # shellcheck disable=SC1090
  source "$f"
  for k in PANEL_HOST PANEL_KEY NODE_KEY INSIDE_KEY RELAY_HOST RELAY_NODE_NAME SIGNIN_HOST PANEL_ORIGIN_NAME PANEL_API_URL NODE_DNS_ZONE CF_ZONES CF_TOKEN_FILE; do
    [[ -n "${!k:-}" ]] || die "$k is not set in $f"
  done
  for k in PANEL_KEY NODE_KEY INSIDE_KEY CF_TOKEN_FILE EXTRA_AUTHORIZED_KEY_FILE; do
    [[ -n "${!k:-}" ]] && printf -v "$k" '%s' "${!k/#\~/$HOME}"
  done
  PANEL_GRPC_PORT="${PANEL_GRPC_PORT:-50051}"
  XRAY_VERSION="${XRAY_VERSION:-v26.3.27}"
  HOP_PORT_BASE="${HOP_PORT_BASE:-47131}"
  [[ "$INSIDE_KEY" != "$NODE_KEY" ]] || die "INSIDE_KEY and NODE_KEY are the same key. The boxes inside the country get their own: a seized box's authorized_keys would otherwise identify every server."
}

# The names a step works on. For `replace` the new name is decided by the
# first step and lives in the run's state, so steps ask for it here.
nn() { if [[ -n "$NAME" ]]; then echo "$NAME"; else state_get name; fi; }
st() { state_get "$@"; }

load_checklists() {
  source "$FLEET_DIR/lib/remote.sh"
  source "$FLEET_DIR/lib/checklist-precheck.sh"
  source "$FLEET_DIR/lib/checklist-add.sh"
  source "$FLEET_DIR/lib/checklist-retire.sh"
  source "$FLEET_DIR/lib/checklist-replace.sh"
  source "$FLEET_DIR/lib/checklist-status.sh"
}

# A run ends as complete only when every step of it passed, or was
# waived on the record (lib/engine.sh conclude_run). --only is one step
# and concludes nothing.
#
# Whatever happens -- a pass, a stop, a failure, an interrupt -- the run
# cleans its scratch files off every host it used (cleanup_hosts) and
# prints how long each step took.
run_and_finish() {
  local from=1 rc=0
  build_mask
  remember_args
  if ! dry; then
    # shellcheck disable=SC2064
    trap "cleanup_hosts; trap - EXIT" EXIT
    trap "exit 130" INT TERM
    [[ -f "$RUN_DIR/timings" ]] && from=$(($(wc -l <"$RUN_DIR/timings") + 1))
    use_dump_given || return 1
  fi
  run_checklist || rc=1
  report_timings "$from"
  [[ $rc -eq 0 ]] || return 1
  if [[ -n "$OPT_ONLY" ]] || dry; then return 0; fi
  conclude_run || return 1
  echo "Run log: $RUN_DIR/run.log"
}

case "$CMD" in
  steps)
    what="${POS[0]:-}"
    OPT_DRY=1 NEW_IP=203.0.113.1 NAME=example-1 OLD=example-0
    PANEL_HOST="" RELAY_HOST="" SIGNIN_HOST="" RELAY_NODE_NAME=relay NODE_DNS_ZONE="" CF_ZONES=""
    load_checklists
    case "$what" in
      precheck) checklist_precheck ;;
      add) checklist_add ;;
      retire) checklist_retire ;;
      replace) checklist_replace ;;
      *) die "steps of what? precheck, add, retire or replace" ;;
    esac
    list_steps
    ;;

  precheck)
    [[ ${#POS[@]} -eq 1 ]] || usage
    NEW_IP="${POS[0]}"
    ip_ok "$NEW_IP"
    NAME="candidate-0"
    load_env
    load_checklists
    checklist_precheck
    open_run precheck "$(tr . - <<<"$NEW_IP")"
    run_and_finish
    ;;

  add)
    [[ ${#POS[@]} -eq 2 ]] || usage
    NAME="${POS[0]}" NEW_IP="${POS[1]}"
    name_ok "$NAME"
    ip_ok "$NEW_IP"
    [[ -n "$REGION" ]] || die "add needs --region (like de-germany; it must match the form its peers use)"
    load_env
    load_checklists
    checklist_add
    open_run add "$NAME"
    run_and_finish
    ;;

  retire)
    [[ ${#POS[@]} -eq 1 ]] || usage
    OLD="${POS[0]}"
    name_ok "$OLD"
    load_env
    load_checklists
    checklist_retire
    open_run retire "$OLD"
    run_and_finish
    ;;

  replace)
    [[ ${#POS[@]} -eq 2 ]] || usage
    OLD="${POS[0]}" NEW_IP="${POS[1]}" NAME="$OPT_NAME"
    name_ok "$OLD"
    ip_ok "$NEW_IP"
    [[ -z "$NAME" ]] || name_ok "$NAME"
    load_env
    load_checklists
    checklist_replace
    open_run replace "$OLD"
    run_and_finish
    ;;

  plan-check)
    # The plan guard of `retire`, for real and read-only: a dry run cannot
    # show its verdict, because it asks the database nothing.
    [[ ${#POS[@]} -eq 1 ]] || usage
    OLD="${POS[0]}"
    name_ok "$OLD"
    load_env
    load_checklists
    RUN_DIR="$(mktemp -d "${TMPDIR:-/tmp}/fleet-plancheck.XXXXXX")"
    # shellcheck disable=SC2064
    trap "rm -rf '$RUN_DIR'" EXIT
    build_mask
    { do_retire_guard_plans && ok_retire_guard_plans; } 2>&1 | mask
    exit "${PIPESTATUS[0]}"
    ;;

  status)
    load_env
    load_checklists
    RUN_DIR="$(mktemp -d "${TMPDIR:-/tmp}/fleet-status.XXXXXX")"
    # shellcheck disable=SC2064
    trap "rm -rf '$RUN_DIR'" EXIT
    build_mask
    fleet_status "${POS[0]:-}" 2>&1 | mask
    exit "${PIPESTATUS[0]}"
    ;;

  dns)
    load_env
    build_mask
    if dry; then
      # Like every other command under --dry-run: say what would be
      # asked of Cloudflare, and ask nothing.
      echo "cloudflare ${POS[*]}" | mask
      exit 0
    fi
    CF_TOKEN_FILE="$CF_TOKEN_FILE" node "$FLEET_DIR/lib/cf.mjs" "${POS[@]}" 2>&1 | mask
    exit "${PIPESTATUS[0]}"
    ;;

  -h | --help | help) usage 0 ;;
  *) usage ;;
esac
